<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.guillermomolina</groupId>
    <artifactId>protos</artifactId>
    <version>0.3.343-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Protos</name>
    <description>Initial Maven project structure for the Protos language implementation.</description>

    <licenses>
        <license>
            <name>Adaptive Public License 1.0</name>
            <url>https://opensource.org/license/apl-1-0</url>
            <distribution>repo</distribution>
            <comments>SPDX identifier: APL-1.0. The complete Protos-specific license, including the completed Exhibit A, is in LICENSE.TXT at the repository root.</comments>
        </license>
    </licenses>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <graalvm.version>25.4.4.1.1</graalvm.version>
        <lsp4j.version>1.0.0</lsp4j.version>
        <protos.shade.skip>false</protos.shade.skip>
        <!-- TEST008: the slow-test confirmation run reports separately. -->
        <protos.surefire.reports>${project.build.directory}/surefire-reports</protos.surefire.reports>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.jline</groupId>
            <artifactId>jline</artifactId>
            <version>3.30.6</version>
        </dependency>
        <dependency>
            <groupId>com.ibm.icu</groupId>
            <artifactId>icu4j</artifactId>
            <version>78.1</version>
        </dependency>
        <dependency>
            <groupId>org.graalvm.sdk</groupId>
            <artifactId>graal-sdk</artifactId>
            <version>${graalvm.version}</version>
        </dependency>
        <dependency>
            <groupId>org.graalvm.polyglot</groupId>
            <artifactId>polyglot</artifactId>
            <version>${graalvm.version}</version>
        </dependency>
        <dependency>
            <groupId>org.graalvm.truffle</groupId>
            <artifactId>truffle-api</artifactId>
            <version>${graalvm.version}</version>
        </dependency>
        <!-- PERF006-C1 / PLAT033: optimizer runtime is present for Maven/Surefire
             but remains external to the shaded Protos application JAR. -->
        <dependency>
            <groupId>org.graalvm.truffle</groupId>
            <artifactId>truffle-runtime</artifactId>
            <version>${graalvm.version}</version>
            <scope>runtime</scope>
        </dependency>
        <!-- LM009-D: real GraalVM DAP instrument, activated only by a debug RuntimeHost. -->
        <dependency>
            <groupId>org.graalvm.polyglot</groupId>
            <artifactId>dap</artifactId>
            <version>${graalvm.version}</version>
            <type>pom</type>
            <scope>runtime</scope>
        </dependency>
        <!-- LM009-F3: standard LSP protocol/stdio host; loaded only by language-server use. -->
        <dependency>
            <groupId>org.eclipse.lsp4j</groupId>
            <artifactId>org.eclipse.lsp4j</artifactId>
            <version>${lsp4j.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.6</version>
                <configuration>
                    <argLine>--enable-native-access=ALL-UNNAMED --sun-misc-unsafe-memory-access=allow</argLine>
                    <reportsDirectory>${protos.surefire.reports}</reportsDirectory>
                    <systemPropertyVariables>
                        <!-- Unpack Truffle internal resources (packaged Core) below target,
                             not into the user's home cache. -->
                        <polyglot.engine.userResourceCache>${project.build.directory}/polyglot-resource-cache</polyglot.engine.userResourceCache>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <showWarnings>true</showWarnings>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.graalvm.truffle</groupId>
                            <artifactId>truffle-dsl-processor</artifactId>
                            <version>${graalvm.version}</version>
                        </path>
                    </annotationProcessorPaths>
                    <compilerArgs>
                        <arg>-Xlint:all</arg>
                    </compilerArgs>
                </configuration>
                <executions>
                    <!-- Test sources declare no Truffle DSL elements, so the
                         processor has nothing to generate for them. -->
                    <execution>
                        <id>default-testCompile</id>
                        <configuration>
                            <proc>none</proc>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>copy-license</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/META-INF</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}</directory>
                                    <includes>
                                        <include>LICENSE.TXT</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <!--
                        Shade post-processes the main JAR in ordinary JVM builds.
                        Always recreate the thin JAR first so repeated package
                        invocations cannot feed a previously shaded JAR back
                        into Shade or Native Image.
                    -->
                    <forceCreation>true</forceCreation>
                    <archive>
                        <manifest>
                            <mainClass>com.guillermomolina.protos.cli.ProtosCli</mainClass>
                            <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <!-- PERF006-C2 / PLAT033: target/runtime is a generated projection of the
                 Graal/Truffle/Polyglot roots already declared by this root POM. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.2.0</version>
                <executions>
                    <!-- PLAT054-3C: package protos/lib as the Truffle internal resource
                         ProtosCoreResource (file list + content hash), so a standard
                         Polyglot embedding needs no protos.CoreRoot or language home. -->
                    <execution>
                        <id>package-core-internal-resource</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <property name="core.resource.root" value="${project.build.outputDirectory}/META-INF/resources/protos/core"/>
                                <property name="core.resource.checksums" value="${project.build.directory}/core-resource-checksums"/>
                                <delete dir="${core.resource.root}" quiet="true"/>
                                <delete dir="${core.resource.checksums}" quiet="true"/>
                                <copy todir="${core.resource.root}/lib">
                                    <fileset dir="${project.basedir}/protos/lib"/>
                                </copy>
                                <pathconvert property="core.resource.files" pathsep="&#10;" dirsep="/">
                                    <fileset dir="${core.resource.root}" includes="lib/**"/>
                                    <globmapper from="${core.resource.root}/*" to="META-INF/resources/protos/core/*=rw-r--r--" handledirsep="true"/>
                                </pathconvert>
                                <echo file="${core.resource.root}/files" message="${core.resource.files}&#10;"/>
                                <checksum algorithm="SHA-256" todir="${core.resource.checksums}" totalproperty="core.resource.sha256" forceoverwrite="yes">
                                    <fileset dir="${core.resource.root}" includes="lib/**"/>
                                </checksum>
                                <echo file="${core.resource.root}/sha256" message="${core.resource.sha256}&#10;"/>
                            </target>
                        </configuration>
                    </execution>
                    <execution>
                        <id>reset-canonical-graal-runtime-plane</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <delete dir="${project.build.directory}/runtime" quiet="true"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.11.0</version>
                <executions>
                    <execution>
                        <id>materialize-canonical-graal-runtime-plane</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <graphRoots>
                                <graphRoot>
                                    <groupId>org.graalvm.sdk</groupId>
                                    <artifactId>graal-sdk</artifactId>
                                </graphRoot>
                                <graphRoot>
                                    <groupId>org.graalvm.polyglot</groupId>
                                    <artifactId>polyglot</artifactId>
                                </graphRoot>
                                <graphRoot>
                                    <groupId>org.graalvm.truffle</groupId>
                                    <artifactId>truffle-api</artifactId>
                                </graphRoot>
                                <graphRoot>
                                    <groupId>org.graalvm.truffle</groupId>
                                    <artifactId>truffle-runtime</artifactId>
                                </graphRoot>
                                <graphRoot>
                                    <groupId>org.graalvm.polyglot</groupId>
                                    <artifactId>dap</artifactId>
                                </graphRoot>
                            </graphRoots>
                            <includeTypes>jar</includeTypes>
                            <outputDirectory>${project.build.directory}/runtime</outputDirectory>
                            <prependGroupId>true</prependGroupId>
                            <stripVersion>false</stripVersion>
                            <useBaseVersion>true</useBaseVersion>
                            <overWriteReleases>true</overWriteReleases>
                            <overWriteSnapshots>true</overWriteSnapshots>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <skip>${protos.shade.skip}</skip>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <artifactSet>
                                <excludes>
                                    <!-- The complete Graal-owned runtime/tool plane is external. -->
                                    <exclude>org.graalvm.*:*</exclude>
                                </excludes>
                            </artifactSet>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.guillermomolina.protos.cli.ProtosCli</mainClass>
                                    <manifestEntries>
                                        <Implementation-Version>${project.version}</Implementation-Version>
                                        <Multi-Release>true</Multi-Release>
                                    </manifestEntries>
                                </transformer>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*:*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>native</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>prepare-native-image-init-args</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <exec executable="bash" failonerror="true">
                                            <arg value="${project.basedir}/build/native/generate-init-args.sh"/>
                                            <arg value="${project.build.outputDirectory}"/>
                                            <arg value="${project.build.directory}/native-image-init.args"/>
                                        </exec>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <version>1.1.14</version>
                        <extensions>true</extensions>
                        <executions>
                            <execution>
                                <id>build-stage1-native</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>compile-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <mainClass>com.guillermomolina.protos.cli.ProtosCli</mainClass>
                            <imageName>protos</imageName>
                            <outputDirectory>${project.build.directory}/native</outputDirectory>
                            <!--
                                Native Image consumes compiled application classes
                                plus the resolved dependency graph directly. Keep
                                the ordinary shaded checkout JAR intact.
                            -->
                            <classesDirectory>${project.build.outputDirectory}</classesDirectory>
                            <!--
                                PLAT045 (#772): Native guest execution uses the
                                supported interpreter-only fallback Truffle
                                runtime while oracle/graal#14579 prevents
                                Bytecode DSL Tier-2 runtime compilation in
                                Native Image. Scoped to this profile only; the
                                JVM path keeps the optimizing runtime.
                            -->
                            <buildArgs>
                                <buildArg>-Dtruffle.UseFallbackRuntime=true</buildArg>
                                <buildArg>-march=compatibility</buildArg>
                                <buildArg>@${project.build.directory}/native-image-init.args</buildArg>
                            </buildArgs>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
