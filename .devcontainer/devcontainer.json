{
  "name": "Protos Development",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/protos,type=bind,consistency=cached",
  "workspaceFolder": "/workspaces/protos",
  "remoteUser": "vscode",
  "updateRemoteUserUID": false,
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "anthropic.claude-code"
      ]
    }
  },
  // Docker:
  // "runArgs": ["--userns=host"],

  // Podman rootless:
  "runArgs": ["--userns=keep-id:uid=1000,gid=1000"],
  "initializeCommand": "mkdir -p \"${localEnv:HOME}/.claude\"",
  "mounts": [
    "source=${localEnv:HOME}/.claude,target=/home/vscode/.claude,type=bind,consistency=cached"
  ]
}
