Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("structural equality vs identity", () => {
        tool009LegacyCase: () => {
            a: Path.relative().child("same")
            b: Path.relative().child("same")
            (a == b) &&
                (a !== b)
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("equal structural paths have equal hash", () => {
        tool009LegacyCase: () => {
            a: Path.relative().child("same")
            b: Path.relative().child("same")
            (a == b) &&
                (a.hash() == b.hash())
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("equality distinguishes structure", () => {
        tool009LegacyCase: () => {
            a: Path.relative().child("x")
            (a != Path.relative().child("y")) &&
                (a != Path.relative()) &&
                (a != 1)
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("component order affects equality", () => {
        tool009LegacyCase: () => {
            ab: Path.relative().child("a").child("b")
            ba: Path.relative().child("b").child("a")
            ab != ba
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("equal component sequences are equal regardless of derivation", () => {
        tool009LegacyCase: () => {
            derived: Path.relative().child("a").child("b")
            other: Path.relative().child("a").child("b")
            (derived == other) &&
                (derived.hash() == other.hash())
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("component separators are data", () => {
        tool009LegacyCase: () => {
            single: Path.relative().child("a/b")
            split: Path.relative().child("a").child("b")
            single != split
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("host separators drives and colons stay one component", () => {
        tool009LegacyCase: () => {
            backslash: Path.relative().child("a\\b")
            drive: Path.relative().child("C:")
            (backslash != Path.relative().child("a").child("b")) &&
                (drive != Path.relative().child("C").child(":"))
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("removed rooted and parent selectors are absent", () => {
        Assertions.signals(Error, () => {
            Path.rooted()
        })
        Assertions.signals(Error, () => {
            Path.relative().parentComponent()
        })
    }),
    Test("equality against another type is false", () => {
        Assertions.require((Path.relative().child("a") == "a") == false)
        Assertions.require((Path.relative() == Path) == false)
    }),
    Test("empty path hash is one", () => {
        Assertions.require(Path.relative().hash() == 1)
    }),
    Test("hash is the 32-bit component sequence hash", () => {
        Assertions.require(Path.relative().child("a").hash() == 128)
        Assertions.require(Path.relative().child("a").child("b").hash() == 4066)
    }),
    Test("hash wraps to a negative signed 32-bit value", () => {
        Assertions.require(Path.relative().child("zzzzzzzz").hash() == 0 - 1910022881)
    }),
    Test("hash stays within signed 32 bits after overflow", () => {
        h: Path.relative().child("zzzzzzzz").child("zzzzzzzz").child("zzzzzzzz").hash()
        Assertions.require((h >= 0 - 2147483648) && (h < 2147483648))
    })
]
tests.freeze()
