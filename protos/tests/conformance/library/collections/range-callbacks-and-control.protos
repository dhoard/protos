Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: Array(
    Test("range callback argument contract", () => {
        tool009LegacyCase: () => {
            Ranges: import("std:collections/Range")
            Assertions: import("std:test/Assertions")

            forwardCalls: 0
            reverseCalls: 0

            Ranges.each(2, 5, (value, ...rest) => {
                Assertions.require(rest.size() == 0)
                Assertions.require(value.parent() === SmallInteger)
                forwardCalls = forwardCalls + 1
            })

            Ranges.reverseEach(2, 5, (value, ...rest) => {
                Assertions.require(rest.size() == 0)
                Assertions.require(value.parent() === SmallInteger)
                reverseCalls = reverseCalls + 1
            })

            (forwardCalls == 3) && (reverseCalls == 3)
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("range callback error propagation", () => {
        tool009LegacyCase: () => {
            Ranges: import("std:collections/Range")

            forwardError: Error()
            reverseError: Error()

            forwardExact: Error.handle(
                () => {
                    Ranges.each(1, 4, (value) => {
                        (value == 2).ifTrue(() => {
                            forwardError.signal()
                        })
                        null
                    })
                    false
                },
                (caught) => {
                    caught === forwardError
                }
            )

            reverseExact: Error.handle(
                () => {
                    Ranges.reverseEach(1, 4, (value) => {
                        (value == 2).ifTrue(() => {
                            reverseError.signal()
                        })
                        null
                    })
                    false
                },
                (caught) => {
                    caught === reverseError
                }
            )

            forwardExact && reverseExact
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("range empty does not inspect callback", () => {
        tool009LegacyCase: () => {
            Ranges: import("std:collections/Range")

            (Ranges.each(4, 4, 42) === null) &&
                (Ranges.reverseEach(4, 4, 42) === null) &&
                (Ranges.each(5, 2, 42) === null) &&
                (Ranges.reverseEach(5, 2, 42) === null)
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("range nonlocal return propagation", () => {
        tool009LegacyCase: () => {
            Ranges: import("std:collections/Range")

            forwardProbe: () => {
                Ranges.each(1, 6, (value) => {
                    (value == 3).ifTrue(() => {
                        ^value
                    })
                })
                99
            }

            reverseProbe: () => {
                Ranges.reverseEach(1, 6, (value) => {
                    (value == 3).ifTrue(() => {
                        ^value
                    })
                })
                99
            }

            (forwardProbe() == 3) &&
                (reverseProbe() == 3)
        }
        Assertions.require(tool009LegacyCase())
    }),
    Test("range reached noninvokable callback rejection", () => {
        tool009LegacyCase: () => {
            Ranges: import("std:collections/Range")
            Assertions: import("std:test/Assertions")

            Assertions.signals(Error, () => {
                Ranges.each(1, 2, 42)
            })

            Assertions.signals(Error, () => {
                Ranges.reverseEach(1, 2, 42)
            })

            true
        }
        Assertions.require(tool009LegacyCase())
    })
)
tests.freeze()
