Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("while arity error", () => {
        Assertions.signals(Error, () => {
            (() => false).whileTrue()
        })
    }),
    Test("while invalid receiver", () => {
        Assertions.signals(Error, () => {
            true.whileTrue(() => { null })
        })
    }),
    Test("while invalid condition future", () => {
        tool009LegacyCase: () => {
            future: (() => false).future()
            bodyCalls: 0
            handled: false
            Error.handle(
                () => {
                    (() => future).whileTrue(() => {
                        bodyCalls = bodyCalls + 1
                    })
                    null
                },
                (caught) => {
                    handled = caught.parent() === Error
                    null
                }
            )
            handled &&
                (bodyCalls == 0)
        }
        Assertions.require(tool009LegacyCase() === true)
    }),
    Test("while invalid condition integer", () => {
        tool009LegacyCase: () => {
            bodyCalls: 0
            handled: false
            Error.handle(
                () => {
                    (() => 42).whileTrue(() => {
                        bodyCalls = bodyCalls + 1
                    })
                    null
                },
                (caught) => {
                    handled = caught.parent() === Error
                    null
                }
            )
            handled &&
                (bodyCalls == 0)
        }
        Assertions.require(tool009LegacyCase() === true)
    }),
    Test("while invalid condition null", () => {
        tool009LegacyCase: () => {
            bodyCalls: 0
            first: Error.handle(
                () => {
                    (() => null).whileTrue(() => {
                        bodyCalls = bodyCalls + 1
                    })
                    null
                },
                (caught) => caught
            )
            second: Error.handle(
                () => {
                    (() => null).whileTrue(() => {
                        bodyCalls = bodyCalls + 1
                    })
                    null
                },
                (caught) => caught
            )
            (first.parent() === Error) &&
                (second.parent() === Error) &&
                (first !== second) &&
                (bodyCalls == 0)
        }
        Assertions.require(tool009LegacyCase() === true)
    }),
    Test("while invalid condition object", () => {
        tool009LegacyCase: () => {
            bodyCalls: 0
            handled: false
            Error.handle(
                () => {
                    (() => Object).whileTrue(() => {
                        bodyCalls = bodyCalls + 1
                    })
                    null
                },
                (caught) => {
                    handled = caught.parent() === Error
                    null
                }
            )
            handled &&
                (bodyCalls == 0)
        }
        Assertions.require(tool009LegacyCase() === true)
    }),
    Test("while multiple iterations", () => {
        tool009LegacyCase: () => {
            i: 0
            condition: () => { i < 4 }
            condition.whileTrue() {
                i = i + 1
            }
            i
        }
        Assertions.require(tool009LegacyCase() == 4)
    }),
    Test("while zero iterations null", () => {
        tool009LegacyCase: () => {
            condition: () => { false }
            condition.whileTrue() { 42 }
        }
        Assertions.require(tool009LegacyCase() === null)
    }),
    Test("while default parameter zero arg activation", () => {
        tool009LegacyCase: () => {
            conditionCalls: 0
            bodyDefaultCalls: 0
            bodyCalls: 0
            nextCondition: () => {
                conditionCalls = conditionCalls + 1
                conditionCalls == 1
            }
            bodyDefault: () => {
                bodyDefaultCalls = bodyDefaultCalls + 1
                99
            }
            condition: (value = nextCondition()) => value
            result: condition.whileTrue((ignored = bodyDefault()) => {
                bodyCalls = bodyCalls + 1
            })
            (result == 1) &&
                (conditionCalls == 2) &&
                (bodyDefaultCalls == 1) &&
                (bodyCalls == 1)
        }
        Assertions.require(tool009LegacyCase() === true)
    }),
    Test("while eager body validation", () => {
        Assertions.signals(Error, () => {
            (() => false).whileTrue(42)
        })
    }),
    Test("whileTrue and while are the standard loop selectors", () => {
        Assertions.require(Object.hasSlot("whileTrue"))
        Assertions.require(Object.hasSlot("while"))
        Assertions.require(!Object.hasSlot("whileFalse"))
    }),
    Test("user-defined while shadows the standard loop", () => {
        tool009LegacyCase: () => {
            holder: {}
            holder.while: (body) => body() + 1
            holder.while(() => 41)
        }
        Assertions.require(tool009LegacyCase() == 42)
    }),
    Test("user-defined whileTrue shadows the standard loop", () => {
        tool009LegacyCase: () => {
            bodyCalls: 0
            holder: {}
            holder.whileTrue: (body) => 7
            result: holder.whileTrue(() => {
                bodyCalls = bodyCalls + 1
            })
            (result == 7) && (bodyCalls == 0)
        }
        Assertions.require(tool009LegacyCase() === true)
    })
]
tests.freeze()
