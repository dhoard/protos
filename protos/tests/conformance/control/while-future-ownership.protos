Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("while body failed future not awaited", () => {
        tool009LegacyCase: () => {
            iterations: 0
            failure: Error()
            condition: () => {
                iterations < 2
            }
            condition.whileTrue() {
                iterations = iterations + 1
                (() => {
                    failure.signal()
                }).future()
            }
            iterations == 2
        }
        Assertions.require(tool009LegacyCase() === true)
    }),
    Test("while body future not cancelled", () => {
        tool009LegacyCase: () => {
            iterations: 0
            saved: null
            condition: () => {
                iterations < 1
            }
            condition.whileTrue() {
                iterations = iterations + 1
                saved = (() => { 42 }).future()
            }
            (saved.value() == 42) &&
                (iterations == 1)
        }
        Assertions.require(tool009LegacyCase() === true)
    }),
    Test("while body future task scoped ownership", () => {
        tool009LegacyCase: () => {
            order: 0
            iterations: 0

            outer: (() => {
                condition: () => {
                    iterations < 1
                }

                condition.whileTrue() {
                    iterations = iterations + 1
                    (() => {
                        order = order * 10 + 2
                        null
                    }).future()
                }

                order = order * 10 + 1
                null
            }).future()

            outer.value()

            (order == 12) &&
                (iterations == 1)
        }
        Assertions.require(tool009LegacyCase() === true)
    }),
    Test("whileTrue returns the last body result", () => {
        tool009LegacyCase: () => {
            i: 0
            result: (() => { i < 1 }).whileTrue() {
                i = i + 1
                99
            }
            (result == 99) && (i == 1)
        }
        Assertions.require(tool009LegacyCase() === true)
    })
]
tests.freeze()
