Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("hash equality coherence", () => {
        tool009LegacyCase: () => {
            a: "hello"
            b: "hel" + "lo"

            (a == b) &&
                (a === b) &&
                (a.hash() == b.hash()) &&
                Integer.recognizes(a.hash())
        }
        Assertions.require(tool009LegacyCase() === true)
    }),
    Test("hash delegated receiver error", () => {
        Assertions.signals(Error, () => {
            Fake: String {}
            Fake.hash()
        })
    }),
    Test("hash wrong arity error", () => {
        Assertions.signals(Error, () => {
            "hello".hash(1)
        })
    })
]
tests.freeze()
