Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("missing int8 binding", () => {
        Assertions.signals(SlotNotFound, () => {
            Int8
        })
    }),
    Test("missing int16 binding", () => {
        Assertions.signals(SlotNotFound, () => {
            Int16
        })
    }),
    Test("missing int32 binding", () => {
        Assertions.signals(SlotNotFound, () => {
            Int32
        })
    }),
    Test("missing int64 binding", () => {
        Assertions.signals(SlotNotFound, () => {
            Int64
        })
    }),
    Test("missing uint8 binding", () => {
        Assertions.signals(SlotNotFound, () => {
            UInt8
        })
    }),
    Test("missing uint16 binding", () => {
        Assertions.signals(SlotNotFound, () => {
            UInt16
        })
    }),
    Test("missing uint32 binding", () => {
        Assertions.signals(SlotNotFound, () => {
            UInt32
        })
    }),
    Test("missing uint64 binding", () => {
        Assertions.signals(SlotNotFound, () => {
            UInt64
        })
    })
]
tests.freeze()
