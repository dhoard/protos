Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("prelude required bindings", () => {
        tool009LegacyCase: () => {
            Object
            Context
            Number
            Integer
            SmallInteger
            BigInteger
            Fraction
            Float
            Complex
            Error
            InvalidReturn
            SlotNotFound
            InvalidSuper
            Cancelled
            FutureResolutionCycle
            RequestOutcomeUncertain
            NonTransferableValue
            NonParallelValue
            ForeignError
            InvalidPredicateResult
            InvalidComparatorResult
            InvalidComparatorOrder
            IOError
            InvalidIOArgument
            IOLifecycleError
            IOCapacityExhausted
            EncodingError
            LineTooLong
            Array
            String
            Encoding
            Map
            IdentityMap
            Path
            Network
            Future
            Actor
            Process
            TextReader
            TextWriter
            import
            true
        }
        Assertions.require(tool009LegacyCase() === true)
    }),
    Test("IP families are std:network members, not Prelude bindings", () => {
        Assertions.signals(SlotNotFound, () => {
            IpAddress
        })
        Assertions.signals(SlotNotFound, () => {
            IpEndpoint
        })
    }),
    Test("buffered byte factories are std:io members, not Prelude bindings", () => {
        Assertions.signals(SlotNotFound, () => {
            BufferedReader
        })
        Assertions.signals(SlotNotFound, () => {
            BufferedWriter
        })
    }),
    Test("missing boolean binding", () => {
        Assertions.signals(SlotNotFound, () => {
            Boolean
        })
    }),
    Test("missing p binding", () => {
        Assertions.signals(SlotNotFound, () => {
            P
        })
    }),
    Test("missing groupref binding", () => {
        Assertions.signals(SlotNotFound, () => {
            GroupRef
        })
    }),
    Test("missing internal groupref binding", () => {
        Assertions.signals(SlotNotFound, () => {
            _coreGroupRefPrototype
        })
    }),
    Test("object identity hash missing error", () => {
        Assertions.signals(SlotNotFound, () => {
            ({}).identityHash()
        })
    }),
    Test("standard owner recognition", () => {
        tool009LegacyCase: () => {
            Assertions: import("std:test/Assertions")

            // String: exact semantic family, not delegation.
            StringLike: String {}

            Assertions.require(String.recognizes("x") === true)
            Assertions.require(String.recognizes(StringLike) === false)
            Assertions.require(String.recognizes(String) === false)

            // Integer: the common domain of both concrete Integer families.
            big: 1234567890123456789012345678901234567890
            Assertions.require(Integer.recognizes(1) === true)
            Assertions.require(Integer.recognizes(big) === true)

            Assertions.require(Integer.recognizes(Integer) === false)
            Assertions.require(Integer.recognizes(SmallInteger) === false)
            Assertions.require(Integer.recognizes(BigInteger) === false)
            Assertions.require(Integer.recognizes(1.0) === false)

            // SmallInteger / BigInteger: disjoint concrete families split at signed-64.
            Assertions.require(SmallInteger.recognizes(1) === true)
            Assertions.require(SmallInteger.recognizes(big) === false)
            Assertions.require(BigInteger.recognizes(big) === true)
            Assertions.require(BigInteger.recognizes(1) === false)

            [Integer, SmallInteger, BigInteger].each((owner) => {
                Assertions.require(owner.recognizes(SmallInteger) === false)
                Assertions.require(owner.recognizes(BigInteger) === false)
                Assertions.require(owner.recognizes(Integer) === false)
                Assertions.require(owner.recognizes(1.0) === false)
                Assertions.require(owner.recognizes({}) === false)
                Assertions.require(owner.recognizes(SmallInteger {}) === false)
                Assertions.require(owner.recognizes(BigInteger {}) === false)
                Assertions.require(owner.recognizes(Integer {}) === false)
            })

            // Float: exact semantic Float, with no numeric promotion.
            Assertions.require(Float.recognizes(1.0) === true)
            Assertions.require(Float.recognizes(1) === false)
            Assertions.require(Float.recognizes(Float) === false)

            // Array: receiver-owned standard indexed state, independent of parent/maturity.
            openArray: Array(1)

            closedArray: Array(2)
            closedArray.close()

            frozenArray: Array(3)
            frozenArray.freeze()

            MyArray: Array {
                label: 9
            }
            descendantArray: MyArray(10, 20)

            ArrayLookalike: Array {}

            Assertions.require(Array.recognizes(openArray) === true)
            Assertions.require(Array.recognizes(closedArray) === true)
            Assertions.require(Array.recognizes(frozenArray) === true)
            Assertions.require(Array.recognizes(descendantArray) === true)
            Assertions.require(descendantArray.parent() === MyArray)
            Assertions.require(Array.recognizes(ArrayLookalike) === false)
            Assertions.require(Array.recognizes(Array) === false)

            // Exact canonical owner receiver.
            Assertions.signals(Error, () => { StringLike.recognizes("x") })

            IntegerLike: Integer {}
            Assertions.signals(Error, () => { IntegerLike.recognizes(1) })

            SmallIntegerLike: SmallInteger {}
            Assertions.signals(Error, () => { SmallIntegerLike.recognizes(1) })

            BigIntegerLike: BigInteger {}
            Assertions.signals(Error, () => { BigIntegerLike.recognizes(big) })

            FloatLike: Float {}
            Assertions.signals(Error, () => { FloatLike.recognizes(1.0) })

            Assertions.signals(Error, () => { MyArray.recognizes(descendantArray) })

            // Exactly one supplied argument for every recognizer.
            assertArity: (owner) => {
                Assertions.signals(Error, () => { owner.recognizes() })
                Assertions.signals(Error, () => { owner.recognizes(null, null) })
                null
            }

            assertArity(String)
            assertArity(Integer)
            assertArity(SmallInteger)
            assertArity(BigInteger)
            assertArity(Float)
            assertArity(Array)

            // Recognition must not dispatch candidate behavior.
            calls: {
                parent: 0
                equality: 0
                hash: 0
                recognizes: 0
            }

            candidateSource: {
                parent: () => {
                    calls.parent = calls.parent + 1
                    Object
                }

                equals: (other) => {
                    calls.equality = calls.equality + 1
                    true
                }

                hash: () => {
                    calls.hash = calls.hash + 1
                    1
                }

                recognizes: (value) => {
                    calls.recognizes = calls.recognizes + 1
                    true
                }
            }

            candidate: candidateSource.alias("equals", "==")

            Assertions.require(String.recognizes(candidate) === false)
            Assertions.require(Integer.recognizes(candidate) === false)
            Assertions.require(SmallInteger.recognizes(candidate) === false)
            Assertions.require(BigInteger.recognizes(candidate) === false)
            Assertions.require(Float.recognizes(candidate) === false)
            Assertions.require(Array.recognizes(candidate) === false)

            Assertions.require(calls.parent == 0)
            Assertions.require(calls.equality == 0)
            Assertions.require(calls.hash == 0)
            Assertions.require(calls.recognizes == 0)

            // No additional standard owner acquires an approved recognizer.

            Assertions.signals(Error, () => { Number.recognizes(1) })
            Assertions.signals(Error, () => { Map.recognizes(null) })
            Assertions.signals(Error, () => { IdentityMap.recognizes(null) })
            Assertions.signals(Error, () => { Bytes.recognizes(null) })

            true
        }
        Assertions.require(tool009LegacyCase() === true)
    })
]
tests.freeze()
