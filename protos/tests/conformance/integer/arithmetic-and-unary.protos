Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("add small", () => {
        tool009LegacyCase: () => {
            1 + 1
        }
        Assertions.require(tool009LegacyCase() == 2)
    }),
    Test("perf043 stable local addition", () => {
        run: () => {
            left: 1
            right: 2
            left + right
        }
        Assertions.require(run() == 3)
    }),
    Test("add beyond int64", () => {
        tool009LegacyCase: () => {
            9223372036854775807 + 1
        }
        Assertions.require(tool009LegacyCase() == 9223372036854775808)
    }),
    Test("subtract negative", () => {
        tool009LegacyCase: () => {
            20 - 22
        }
        Assertions.require(tool009LegacyCase() == -2)
    }),
    Test("multiply", () => {
        tool009LegacyCase: () => {
            20 * 22
        }
        Assertions.require(tool009LegacyCase() == 440)
    }),
    Test("multiply big", () => {
        tool009LegacyCase: () => {
            999999999999999999999999 * 999999999999999999999999
        }
        Assertions.require(tool009LegacyCase() == 999999999999999999999998000000000000000000000001)
    }),
    Test("negated", () => {
        tool009LegacyCase: () => {
            -123
        }
        Assertions.require(tool009LegacyCase() == -123)
    }),
    Test("double negated", () => {
        tool009LegacyCase: () => {
            -(-123)
        }
        Assertions.require(tool009LegacyCase() == 123)
    }),
    Test("mixed add returns Float", () => {
        Assertions.require((1 + 1.0) === 2.0)
    }),
    Test("mixed subtract returns Float", () => {
        Assertions.require((1 - 1.0) === 0.0)
    }),
    Test("mixed multiply returns Float", () => {
        Assertions.require((1 * 1.0) === 1.0)
    }),
    Test("mixed addition rounds Integer operand first", () => {
        Assertions.require(
            (9007199254740993 + (-9007199254740992.0)) === 0.0
        )
    }),
    Test("mixed division uses Float semantics", () => {
        Assertions.require((1 / 0.0) === (1.0 / 0.0))
        Assertions.require((7 / 2.0) === 3.5)
    }),
    Test("mixed signed64 boundary rounds Integer first", () => {
        Assertions.require(
            (9223372036854775807 + (-9223372036854775808.0)) === 0.0
        )
    }),
    Test("mixed huge Integer converts to infinity first", () => {
        huge: 
        Assertions.require((huge * 0.0) === (0.0 / 0.0))
        Assertions.require(
            (huge + (1.0 / -0.0)) === (0.0 / 0.0)
        )
    }),
    Test("mixed division by negative Float zero", () => {
        Assertions.require((1 / -0.0) === (1.0 / -0.0))
    }),
    Test("integer-only selectors reject Float", () => {
        Assertions.signals(Error, () => { 7.div(2.0) })
        Assertions.signals(Error, () => { 7.mod(2.0) })
        Assertions.signals(Error, () => { 7 % 2.0 })
    }),
    Test("copied standard plus noninteger receiver error", () => {
        Assertions.signals(Error, () => {
            copiedPlus: Integer.slotValue("+")
            ordinary: {
                plus: copiedPlus
            }

            ordinary.plus(1)
        })
    }),
    Test("negated delegated noninteger receiver error", () => {
        Assertions.signals(Error, () => {
            incompatible: Integer {}
            incompatible.negated()
        })
    })
]
tests.freeze()
