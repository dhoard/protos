Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("division half", () => {
        tool009LegacyCase: () => {
            Float(1 / 2)
        }
        Assertions.require(tool009LegacyCase() === 0.5)
    }),
    Test("division third", () => {
        tool009LegacyCase: () => {
            Float(1 / 3)
        }
        Assertions.require(tool009LegacyCase() === 0.3333333333333333)
    }),
    Test("division negative", () => {
        tool009LegacyCase: () => {
            Float(-1 / 2)
        }
        Assertions.require(tool009LegacyCase() === -0.5)
    }),
    Test("division negative divisor", () => {
        tool009LegacyCase: () => {
            Float(1 / (-2))
        }
        Assertions.require(tool009LegacyCase() === -0.5)
    }),
    Test("division exact zero", () => {
        tool009LegacyCase: () => {
            Float(0 / (-3))
        }
        Assertions.require(tool009LegacyCase() === 0.0)
    }),
    Test("division negative zero", () => {
        tool009LegacyCase: () => {
            Float(-1 / )
        }
        Assertions.require(tool009LegacyCase() === -0.0)
    }),
    Test("division subnormal tie up", () => {
        tool009LegacyCase: () => {
            Float(3 / )
        }
        Assertions.require(tool009LegacyCase() === 1e-323)
    }),
    Test("division half min subnormal", () => {
        tool009LegacyCase: () => {
            Float(1 / )
        }
        Assertions.require(tool009LegacyCase() === 0.0)
    }),
    Test("division tie even down", () => {
        tool009LegacyCase: () => {
            Float(9007199254740993 / 9007199254740992)
        }
        Assertions.require(tool009LegacyCase() === 1.0)
    }),
    Test("division tie even up", () => {
        tool009LegacyCase: () => {
            Float(9007199254740995 / 9007199254740992)
        }
        Assertions.require(tool009LegacyCase() === 1.0000000000000004)
    }),
    Test("division huge exact one", () => {
        tool009LegacyCase: () => {
            Float( / )
        }
        Assertions.require(tool009LegacyCase() === 1.0)
    }),
    Test("division overflow", () => {
        tool009LegacyCase: () => {
            Float( / 1)
        }
        Assertions.require(tool009LegacyCase() === 1.0 / 0.0)
    })
]
tests.freeze()
