Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("number prototype slot visible", () => {
        tool009LegacyCase: () => {
            (42) < 43
        }
        Assertions.require(tool009LegacyCase() === true)
    }),
    Test("prototype local slot visible", () => {
        tool009LegacyCase: () => {
            (42).negated()
        }
        Assertions.require(tool009LegacyCase() == -42)
    }),
    Test("extracted inherited method preserves receiver", () => {
        tool009LegacyCase: () => {
            ((23).negated)()
        }
        Assertions.require(tool009LegacyCase() == -23)
    }),
    Test("numeric parent does not confer membership", () => {
        Assertions.signals(Error, () => {
            child: (7) {}
            child + 1
        })
    }),
    Test("numeric value parent continues family lookup", () => {
        tool009LegacyCase: () => {
            child: (7) {}
            numeric: child.parent()
            (numeric.parent() === SmallInteger) &&
                (SmallInteger.parent() === Integer) &&
                (Integer.parent() === Number)
        }
        Assertions.require(tool009LegacyCase() === true)
    }),
    Test("integer receivers are not instantiable prototypes at any magnitude", () => {
        Assertions.signals(Error, () => (7).call())
        Assertions.signals(Error, () => (100000000000000000000).call())
        Assertions.signals(Error, () => ((100000000000000000000).call)())
        Assertions.signals(Error, () => {
            child: (100000000000000000000) {}
            child.call()
        })
    }),
    Test("integer reflection exposes the concrete family", () => {
        small: 7
        large: 100000000000000000000
        Assertions.require(small.hasSlot("parent") === false)
        Assertions.require(large.hasSlot("parent") === false)
        Assertions.require(small.slotNames().size() == 0)
        Assertions.require(large.slotNames().size() == 0)
        Assertions.require(small.parent() === SmallInteger)
        Assertions.require(large.parent() === BigInteger)
        Assertions.signals(Error, () => small.slotValue("parent"))
        Assertions.signals(Error, () => large.slotValue("parent"))
        Assertions.signals(Error, () => small.removeSlot("parent"))
        Assertions.signals(Error, () => large.removeSlot("parent"))
    })
]
tests.freeze()
