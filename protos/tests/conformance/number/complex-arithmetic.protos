// D198 (I090): public Complex construction, components and standard arithmetic. A
// helper compares Float coordinates by identity, so signed zeros and NaN are exact.

Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

nan: 0.0 / 0.0
inf: 1.0 / 0.0
negativeZero: -0.0

same: (value, re, im) => {
    Complex.recognizes(value) && (value.real() === re) && (value.imaginary() === im)
}

tests: [
    Test("factory canonical form", () => {
        Assertions.require(Complex(3, 0) === 3)
        Assertions.require(SmallInteger.recognizes(Complex(3, 0)))
        Assertions.require(same(Complex(3, 0.0), 3, 0.0))
        Assertions.require(same(Complex(3, negativeZero), 3, negativeZero))
        Assertions.require(same(Complex(3, 1 / 2), 3, 1 / 2))
        Assertions.require(Complex(3, 0.0) !== Complex(3, negativeZero))
        Assertions.require(same(Complex(nan, inf), nan, inf))
        Assertions.require(Complex(1, 2).parent() === Complex)
    }),
    Test("factory errors", () => {
        Assertions.signals(Error, () => { Complex() })
        Assertions.signals(Error, () => { Complex(1) })
        Assertions.signals(Error, () => { Complex(1, 2, 3) })
        Assertions.signals(Error, () => { Complex(Complex(1, 2), 1) })
        Assertions.signals(Error, () => { Complex(1, Complex(1, 2)) })
        Assertions.signals(Error, () => { Complex("1", 2) })
        Assertions.signals(Error, () => { Complex(Integer {}, 2) })
        Assertions.signals(Error, () => { Complex(1, Number {}) })
        Assertions.signals(Error, () => {
            ComplexLike: Complex {}
            ComplexLike(1, 2)
        })
    }),
    Test("components", () => {
        z: Complex(3, 4)
        Assertions.require(z.real() === 3)
        Assertions.require(z.imaginary() === 4)
        Assertions.require(Complex(z.real(), z.imaginary()) === z)
        big: 18446744073709551616
        Assertions.require(Complex(big, 1 / 3).real() === big)
        Assertions.require((7).real() === 7)
        Assertions.require((7).imaginary() === 0)
        Assertions.require((1 / 2).real() === (1 / 2))
        Assertions.require((1 / 2).imaginary() === 0)
        Assertions.require(nan.real() === nan)
        Assertions.require(negativeZero.real() === negativeZero)
        Assertions.require(SmallInteger.recognizes(inf.imaginary()))
        Assertions.signals(Error, () => { Number.real() })
        Assertions.signals(Error, () => { Number {}.imaginary() })
        Assertions.signals(Error, () => { z.real(1) })
    }),
    Test("separable arithmetic in both directions", () => {
        z: Complex(1, 2)
        Assertions.require((z + Complex(3, 4)) === Complex(4, 6))
        Assertions.require((z - Complex(3, 4)) === Complex(0 - 2, 0 - 2))
        Assertions.require((z + 5) === Complex(6, 2))
        Assertions.require((5 + z) === Complex(6, 2))
        Assertions.require((z - 5) === Complex(0 - 4, 2))
        Assertions.require((5 - z) === Complex(4, 0 - 2))
        Assertions.require((z * 3) === Complex(3, 6))
        Assertions.require((3 * z) === Complex(3, 6))
        Assertions.require((z / 2) === Complex(1 / 2, 1))
        Assertions.require((-z) === Complex(0 - 1, 0 - 2))
        Assertions.require(((1 / 2) + z) === Complex(3 / 2, 2))
        Assertions.require(((1 / 2) - z) === Complex(0 - (1 / 2), 0 - 2))
        Assertions.require(((1 / 2) * z) === Complex(1 / 2, 1))
        Assertions.require((z + Complex(0, 0 - 2)) === 1)
        Assertions.require(same(Complex(1.0, negativeZero) + 3, 4.0, negativeZero))
        Assertions.require(same(Complex(1.0, negativeZero) * 1.0, 1.0, negativeZero))
        Assertions.require(same(Complex(1, 1 / 3) + 0.5, 1.5, 1 / 3))
        Assertions.require(same(2.0 * Complex(1, 2), 2.0, 4.0))
        Assertions.require(same(Complex(nan, 1) + Complex(2, 3), nan, 4))
        Assertions.require(same(1 - Complex(1.0, negativeZero), 0.0, 0.0))
    }),
    Test("integer families promote and demote", () => {
        max: 9223372036854775807
        sum: Complex(max, 1) + 1
        Assertions.require(BigInteger.recognizes(sum.real()))
        Assertions.require(SmallInteger.recognizes((sum - 1).real()))
        Assertions.require((sum - 1) === Complex(max, 1))
    }),
    Test("exact coupled arithmetic", () => {
        z: Complex(1, 2)
        w: Complex(3, 4)
        Assertions.require((z * w) === Complex(0 - 5, 10))
        Assertions.require((z / w) === Complex(11 / 25, 2 / 25))
        Assertions.require((1 / w) === Complex(3 / 25, 0 - (4 / 25)))
        Assertions.require(((1 / 2) / w) === Complex(3 / 50, 0 - (2 / 25)))
        Assertions.require((Complex(1, 1) * Complex(1, 0 - 1)) === 2)
        Assertions.require((Complex(2, 2) / Complex(1, 1)) === 2)
    }),
    Test("division by exact zero", () => {
        Assertions.signals(Error, () => { Complex(1, 2) / 0 })
        Assertions.signals(Error, () => { Complex(1 / 2, 2) / 0 })
        Assertions.require(same(Complex(1.0, 2) / 0, inf, inf))
        Assertions.require(same(Complex(-1.0, 2) / 0, -inf, inf))
        Assertions.require(same(Complex(0.0, 2) / 0, nan, inf))
        Assertions.require(same(Complex(nan, 2) / 0, nan, inf))
        Assertions.require(same(Complex(1, 2) / 0.0, inf, inf))
    }),
    Test("float coupled signed zeros", () => {
        Assertions.require(same(Complex(1.0, negativeZero) * Complex(1.0, 0.0), 1.0, 0.0))
        Assertions.require(same(Complex(1.0, negativeZero) / Complex(2.0, 0.0), 0.5, negativeZero))
        Assertions.require(same(0.0 / Complex(1.0, 1.0), 0.0, negativeZero))
    }),
    Test("float coupled exceptional values", () => {
        Assertions.require(same(Complex(inf, 0.0) * Complex(0.0, 1.0), nan, inf))
        Assertions.require(same(Complex(nan, inf) * Complex(1.0, 1.0), nan, nan))
        Assertions.require(same(Complex(1, 2) / Complex(0.0, 0.0), inf, inf))
        Assertions.require(same(Complex(1, 2) / Complex(negativeZero, 0.0), -inf, -inf))
        Assertions.require(same(Complex(0, 2) / Complex(0.0, 0.0), nan, inf))
        Assertions.require(same(Complex(0, 0.0) / Complex(0.0, 0.0), nan, nan))
        Assertions.require(same(Complex(inf, inf) / Complex(inf, -inf), nan, nan))
        Assertions.require(same(Complex(1, 2) / Complex(inf, -inf), negativeZero, 0.0))
        Assertions.require(same(1.0 / Complex(0.0, 0.0), inf, nan))
    }),
    Test("equality identity and ordering", () => {
        Assertions.require(Complex(3, 0.0) == 3)
        Assertions.require(Complex(3, 0.0) !== 3)
        Assertions.require(Complex(1, 1 / 2) == Complex(1.0, 0.5))
        Assertions.require(Complex(1, 1 / 2) !== Complex(1.0, 0.5))
        Assertions.require(Complex(3, 0.0).hash() == (3).hash())
        Assertions.require(Complex(nan, 1) != Complex(nan, 1))
        Assertions.require(Complex(nan, 1) === Complex(nan, 1))
        Assertions.signals(Error, () => { Complex(1, 2) < 3 })
        Assertions.signals(Error, () => { 3 >= Complex(1, 2) })
        Assertions.signals(Error, () => { Integer(Complex(1, 0.0)) })
        Assertions.signals(Error, () => { Float(Complex(1, 0.0)) })
        Assertions.signals(Error, () => { 7.div(Complex(1, 2)) })
        Assertions.signals(Error, () => { 7 % Complex(1, 2) })
    }),
    Test("arithmetic is ordinary overridable dispatch", () => {
        ShadowSource: Complex {
            combine: (other) => { "shadowed" }
        }
        Shadow: ShadowSource.alias("combine", "+")
        Assertions.require((Shadow + 1) == "shadowed")
        Delegating: Complex {}
        Assertions.signals(Error, () => { Delegating + 1 })
        Assertions.signals(Error, () => { -Delegating })
        Assertions.signals(Error, () => { Complex(1, 2) + "x" })
        Assertions.signals(Error, () => { 1 + Delegating })
        Assertions.signals(Error, () => { 1.0 * Delegating })
        Assertions.signals(Error, () => { (1 / 2) - Delegating })
    })
]
