// D197-C (I090-B): Integer / Integer is the canonical exact quotient, and
// Fraction arithmetic is exact rational arithmetic with canonical results.

Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("quotient normalization", () => {
        Assertions.require(Fraction.recognizes(1 / 2))
        Assertions.require((2 / 4) === (1 / 2))
        Assertions.require(((0 - 2) / 4) === ((0 - 1) / 2))
        Assertions.require((2 / (0 - 4)) === ((0 - 1) / 2))
        Assertions.require(((0 - 2) / (0 - 4)) === (1 / 2))
        Assertions.require(((1 / 2).parent()) === Fraction)
        Assertions.require(Fraction.parent() === Number)
    }),
    Test("integral quotients are Integers", () => {
        Assertions.require(SmallInteger.recognizes(0 / 7))
        Assertions.require((0 / 7) === 0)
        Assertions.require((6 / 3) === 2)
        Assertions.require(((0 - 6) / 3) === (0 - 2))
        Assertions.require(BigInteger.recognizes(9223372036854775808 / 1))
        Assertions.require(BigInteger.recognizes((0 - 9223372036854775807 - 1) / (0 - 1)))
        Assertions.require(((0 - 9223372036854775807 - 1) / (0 - 1)) == 9223372036854775808)
        Assertions.require(SmallInteger.recognizes(18446744073709551616 / 4294967296))
    }),
    Test("components beyond signed 64", () => {
        big: 18446744073709551616
        q: 1 / big
        Assertions.require(Fraction.recognizes(q))
        Assertions.require((q * big) === 1)
        Assertions.require(Fraction.recognizes(big / 3))
        Assertions.require(((big / 3) * 3) === big)
        huge: 
        tiny: 1 / huge
        Assertions.require(Fraction.recognizes(tiny))
        Assertions.require((tiny * huge) === 1)
        Assertions.require((tiny > 0) && (tiny < 5e-324))
    }),
    Test("division by exact zero error", () => {
        Assertions.signals(Error, () => { 1 / 0 })
        Assertions.signals(Error, () => { (1 / 2) / 0 })
        Assertions.signals(Error, () => { 3 / (1 - 1) })
    }),
    Test("fraction and fraction", () => {
        Assertions.require(((1 / 2) + (1 / 3)) === (5 / 6))
        Assertions.require(((1 / 2) - (1 / 3)) === (1 / 6))
        Assertions.require(((2 / 3) * (3 / 4)) === (1 / 2))
        Assertions.require(((1 / 6) / (1 / 3)) === (1 / 2))
        Assertions.require(((1 / 2) + (1 / 2)) === 1)
        Assertions.require(SmallInteger.recognizes((1 / 3) * 3))
        Assertions.require(((1 / 3) - (1 / 3)) === 0)
    }),
    Test("fraction and integer in both orders", () => {
        Assertions.require(((1 / 2) + 1) === (3 / 2))
        Assertions.require((1 + (1 / 2)) === (3 / 2))
        Assertions.require(((1 / 2) - 1) === ((0 - 1) / 2))
        Assertions.require((1 - (1 / 2)) === (1 / 2))
        Assertions.require(((1 / 2) * 4) === 2)
        Assertions.require((4 * (1 / 2)) === 2)
        Assertions.require(((1 / 2) / 2) === (1 / 4))
        Assertions.require((2 / (1 / 2)) === 4)
        Assertions.require((2 / (2 / 3)) === 3)
    }),
    Test("negation", () => {
        Assertions.require((1 / 3).negated() === ((0 - 1) / 3))
        Assertions.require(((0 - 1) / 3).negated() === (1 / 3))
    }),
    Test("div mod and percent stay Integer only", () => {
        Assertions.require((7.div(2)) === 3)
        Assertions.require((7.mod(2)) === 1)
        Assertions.require(((0 - 7).div(2)) === (0 - 3))
        Assertions.require(((0 - 7).mod(2)) === (0 - 1))
        Assertions.signals(Error, () => { 7.div(1 / 2) })
        Assertions.signals(Error, () => { 7.mod(1 / 2) })
        Assertions.signals(Error, () => { (1 / 2).div(1) })
    }),
    Test("fraction and float are operand first", () => {
        Assertions.require(((1 / 2) + 0.25) === 0.75)
        Assertions.require((0.25 + (1 / 2)) === 0.75)
        Assertions.require(((1 / 3) + 0.0) === (1.0 / 3.0))
        Assertions.require((0.0 + (1 / 3)) === (1.0 / 3.0))
        Assertions.require(((1 / 2) * 2.0) === 1.0)
        Assertions.require((1.0 - (1 / 2)) === 0.5)
        Assertions.require(((1 / 2) / 0.0) === (1.0 / 0.0))
        Assertions.require((((0 - 1) / 2) * 0.0) === -0.0)
        nan: 0.0 / 0.0
        Assertions.require(((1 / 2) + nan) === nan)
        Assertions.require(((1 / 2) * (1.0 / 0.0)) === (1.0 / 0.0))
    }),
    Test("float conversion rounds the whole quotient once", () => {
        Assertions.require(Float(1 / 3) === 0.3333333333333333)
        Assertions.require(Float(1 / 10) === 0.1)
        huge: 
        nearOne: (huge + 1) / huge
        Assertions.require(Fraction.recognizes(nearOne))
        Assertions.require(Float(nearOne) === 1.0)
        Assertions.require((nearOne + 0.0) === 1.0)
        Assertions.require(Float(1 / huge) === 0.0)
        Assertions.require(Float((0 - 1) / huge) === -0.0)
        Assertions.signals(Error, () => { Integer(1 / 2) })
    })
]
tests.freeze()
