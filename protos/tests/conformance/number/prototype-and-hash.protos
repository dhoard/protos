Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("prototype hierarchy", () => {
        tool009LegacyCase: () => {
            (Number.parent() === Object) &&
                (Integer.parent() === Number) &&
                (Fraction.parent() === Number) &&
                (Float.parent() === Number) &&
                (Complex.parent() === Number)
        }
        Assertions.require(tool009LegacyCase() === true)
    }),
    // I090-C1: no public Complex constructor exists yet, so only rejection is observable here.
    Test("complex recognizes only genuine values", () => {
        Assertions.require(Complex.recognizes(Complex) === false)
        Assertions.require(Complex.recognizes(1) === false)
        Assertions.require(Complex.recognizes(1 / 2) === false)
        Assertions.require(Complex.recognizes(1.0) === false)
        Assertions.require(Complex.recognizes(Complex {}) === false)
        forged: Complex {}
        forged.freeze()
        Assertions.require(Complex.recognizes(forged) === false)
    }),
    Test("complex recognizes receiver and arity errors", () => {
        Assertions.signals(Error, () => { Complex.recognizes() })
        Assertions.signals(Error, () => { Complex.recognizes(1, 2) })
        Assertions.signals(Error, () => {
            ComplexLike: Complex {}
            ComplexLike.recognizes(1)
        })
    }),
    Test("complex delegating objects stay nonnumeric", () => {
        Assertions.signals(Error, () => {
            forged: Complex {}
            forged.freeze()
            forged.hash()
        })
        Assertions.signals(Error, () => {
            forged: Complex {}
            forged < 1
        })
    }),
    Test("hash equality coherence", () => {
        tool009LegacyCase: () => {
            nanA: 0.0 / 0.0
            nanB: 0.0 / 0.0

            (1.hash() == 1.0.hash()) &&
                (0.0.hash() == (-0.0).hash()) &&
                (nanA.hash() == nanB.hash()) &&
                Integer.recognizes(1.hash())
        }
        Assertions.require(tool009LegacyCase() === true)
    }),
    Test("hash non number receiver error", () => {
        Assertions.signals(Error, () => {
            notNumber: Number {}
            notNumber.hash()
        })
    }),
    Test("hash wrong arity error", () => {
        Assertions.signals(Error, () => {
            1.hash(2)
        })
    })
]
tests.freeze()
