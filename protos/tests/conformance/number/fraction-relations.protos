// D197-C (I090-B): exact mathematical equality and ordering across Integer,
// Fraction and binary64 Float; family-sensitive identity; coherent hashes;
// trusted Fraction authenticity.

Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("exact equality with float", () => {
        Assertions.require((1 / 2) == 0.5)
        Assertions.require(0.5 == (1 / 2))
        Assertions.require(((1 / 10) == 0.1) === false)
        Assertions.require((0.1 == (1 / 10)) === false)
        Assertions.require(((1 / 2) == 0) === false)
        Assertions.require(((1 / 2) == "1/2") === false)
    }),
    Test("identity is family sensitive", () => {
        Assertions.require((2 / 4) === (1 / 2))
        Assertions.require(((1 / 2) === 0.5) === false)
        Assertions.require(((4 / 2) === 2.0) === false)
        Assertions.require(((1 / 2) === (1 / 3)) === false)
    }),
    Test("ordering without precision loss", () => {
        Assertions.require((1 / 3) < (1 / 2))
        Assertions.require((2 / 3) > (1 / 2))
        Assertions.require((1 / 2) <= (2 / 4))
        Assertions.require((1 / 2) >= (2 / 4))
        Assertions.require(((0 - 1) / 2) < 0)
        Assertions.require(1 > (9223372036854775807 / 9223372036854775808))
        Assertions.require((9223372036854775807 / 9223372036854775808) > (9223372036854775806 / 9223372036854775807))
        // binary64 1/3 is slightly below the exact rational.
        Assertions.require((1 / 3) > 0.3333333333333333)
        Assertions.require(0.3333333333333333 < (1 / 3))
    }),
    Test("float comparison across two to the fifty three", () => {
        above: 18014398509481985 / 2
        Assertions.require(above > 9007199254740992.0)
        Assertions.require(above < 9007199254740994.0)
        Assertions.require((above == 9007199254740992.0) === false)
        Assertions.require(Float(above) === 9007199254740992.0)
    }),
    Test("special float values", () => {
        nan: 0.0 / 0.0
        positiveInfinity: 1.0 / 0.0
        negativeInfinity: -1.0 / 0.0
        Assertions.require(((1 / 2) < nan) === false)
        Assertions.require(((1 / 2) >= nan) === false)
        Assertions.require((nan > (1 / 2)) === false)
        Assertions.require(((1 / 2) == nan) === false)
        Assertions.require((1 / 2) < positiveInfinity)
        Assertions.require((1 / 2) > negativeInfinity)
        Assertions.require(((0 - 1) / 2) < -0.0)
        Assertions.require((1 / 2) > 0.0)
        Assertions.require((1 / 2) > 5e-324)
    }),
    Test("hash coherence", () => {
        Assertions.require((1 / 2).hash() == 0.5.hash())
        Assertions.require((2 / 4).hash() == (1 / 2).hash())
        Assertions.require(Integer.recognizes((1 / 3).hash()))
    }),
    Test("map and identity map keys", () => {
        m: Map()
        m.atPut(1 / 2, 10)
        m.atPut(0.5, 20)
        m.atPut(2 / 4, 30)
        Assertions.require(m.size() == 1)
        Assertions.require(m.at(1 / 2) == 30)

        identities: IdentityMap()
        identities.atPut(1 / 2, 10)
        identities.atPut(0.5, 20)
        identities.atPut(2 / 4, 30)
        Assertions.require(identities.size() == 2)
        Assertions.require(identities.at(1 / 2) == 30)
        Assertions.require(identities.at(0.5) == 20)
    }),
    Test("recognizes only genuine fractions", () => {
        Assertions.require(Fraction.recognizes(1 / 3))
        Assertions.require(Fraction.recognizes(2) === false)
        Assertions.require(Fraction.recognizes(0.5) === false)
        Assertions.require(Fraction.recognizes(Fraction) === false)
        Assertions.require(Fraction.recognizes(Fraction {}) === false)
        forged: Fraction {}
        forged.freeze()
        Assertions.require(Fraction.recognizes(forged) === false)
        Assertions.require(Integer.recognizes(1 / 3) === false)
        Assertions.require(Float.recognizes(1 / 3) === false)
    }),
    Test("recognizes receiver and arity errors", () => {
        Assertions.signals(Error, () => { Fraction.recognizes() })
        Assertions.signals(Error, () => { Fraction.recognizes(1, 2) })
        Assertions.signals(Error, () => {
            FractionLike: Fraction {}
            FractionLike.recognizes(1 / 3)
        })
    }),
    Test("forged and delegating objects stay nonnumeric", () => {
        Assertions.signals(Error, () => {
            forged: Fraction {}
            forged + 1
        })
        Assertions.signals(Error, () => {
            notNumber: Number {}
            notNumber < 1
        })
        Assertions.signals(Error, () => { 1 + (Fraction {}) })
        Assertions.require((1 == (Fraction {})) === false)
    }),
    Test("no public fraction constructor", () => {
        Assertions.signals(Error, () => { Fraction(1, 3) })
        Assertions.signals(Error, () => { Fraction(1) })
    })
]
tests.freeze()
