Assertions: import("std:test/Assertions")
Test: import("std:test/Test")

tests: [
    Test("parent arity", () => {
        Assertions.signals(Error, () => {
            ({}).parent(1)
        })
    }),
    Test("parent error taxonomy", () => {
        tool009LegacyCase: () => {
            (Error.parent() === Object) &&
                (InvalidReturn.parent() === Error) &&
                (SlotNotFound.parent() === Error) &&
                (InvalidSuper.parent() === Error) &&
                (Cancelled.parent() === Error) &&
                (FutureResolutionCycle.parent() === Error) &&
                (RequestOutcomeUncertain.parent() === Error) &&
                (NonTransferableValue.parent() === Error) &&
                (NonParallelValue.parent() === Error) &&
                (ForeignError.parent() === Error) &&
                (InvalidPredicateResult.parent() === Error) &&
                (InvalidComparatorResult.parent() === Error) &&
                (InvalidComparatorOrder.parent() === Error) &&
                (IOError.parent() === Error) &&
                (InvalidIOArgument.parent() === IOError) &&
                (IOLifecycleError.parent() === IOError) &&
                (IOCapacityExhausted.parent() === IOError) &&
                (EncodingError.parent() === IOError) &&
                (LineTooLong.parent() === IOError)
        }
        Assertions.require(tool009LegacyCase() === true)
    }),
    Test("parent number string", () => {
        tool009LegacyCase: () => {
            ((1).parent() === SmallInteger) &&
                ((1.0).parent() === Float) &&
                (("x").parent() === String)
        }
        Assertions.require(tool009LegacyCase() === true)
    }),
    Test("parent ordinary", () => {
        tool009LegacyCase: () => {
            base: {}
            child: base {}
            plain: {}

            (plain.parent() === Object) &&
                (child.parent() === base)
        }
        Assertions.require(tool009LegacyCase() === true)
    }),
    Test("parent singletons", () => {
        tool009LegacyCase: () => {
            ((true).parent() === Object) &&
                ((false).parent() === Object) &&
                ((null).parent() === Object)
        }
        Assertions.require(tool009LegacyCase() === true)
    }),
    Test("root parent", () => {
        Assertions.signals(Error, () => {
            Object.parent()
        })
    })
]
tests.freeze()
