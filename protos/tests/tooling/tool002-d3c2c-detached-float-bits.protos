Manifest: import("self:Manifest")
Runner: import("self:Runner")

negativeZero: Runner.evaluateSimple(
    Manifest.parseLine("negative-zero.protos\tfloat-bits\t8000000000000000"),
    "-0.0",
    execution
)

third: Runner.evaluateSimple(
    Manifest.parseLine("third.protos\tfloat-bits\t3fd5555555555555"),
    "Float(1 / 3)",
    execution
)

Runner.resultPassed(negativeZero) &&
Runner.resultPassed(third) &&
(Runner.resultObservation(negativeZero).state === "completed") &&
(Runner.resultObservation(third).state === "completed")
