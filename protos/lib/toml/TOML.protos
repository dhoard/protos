//! TOML node trees and whole-document parsing and encoding. Nodes are objects with
//! `kind` and `value` slots.

/// Answers a fresh TOML string node; `value` must be a String.
string: (value) => {
    String.recognizes(value).ifFalse(() => {
        Error().signal()
    })

    {
        kind: "string"
        value: value
    }
}

/// Answers a fresh TOML integer node; `value` must be an Integer.
integer: (value) => {
    Integer.recognizes(value).ifFalse(() => {
        Error().signal()
    })

    {
        kind: "integer"
        value: value
    }
}

/// Answers a fresh TOML float node; `value` must be a Float.
float: (value) => {
    Float.recognizes(value).ifFalse(() => {
        Error().signal()
    })

    {
        kind: "float"
        value: value
    }
}

/// Answers a fresh TOML boolean node; `value` must be canonical `true` or `false`.
boolean: (value) => {
    valid: value === true
    (value === false).ifTrue(() => {
        valid = true
    })
    valid.ifFalse(() => {
        Error().signal()
    })

    {
        kind: "boolean"
        value: value
    }
}

/// Answers a fresh TOML local-date node. Validates the year (1..9999), month, and day
/// against the proleptic Gregorian calendar.
localDate: (year, month, day) => {
    ignoredYearValidation: 0 + year
    ignoredMonthValidation: 0 + month
    ignoredDayValidation: 0 + day

    ((year < 1) || (year > 9999)).ifTrue(() => {
        Error().signal()
    })
    ((month < 1) || (month > 12)).ifTrue(() => {
        Error().signal()
    })

    maxDay: 31
    ((month == 4) || (month == 6) || (month == 9) || (month == 11)).ifTrue(() => {
        maxDay = 30
    })
    (month == 2).ifTrue(() => {
        leap: false
        (year.mod(4) == 0).ifTrue(() => {
            leap = true
        })
        (year.mod(100) == 0).ifTrue(() => {
            leap = false
        })
        (year.mod(400) == 0).ifTrue(() => {
            leap = true
        })
        maxDay = 28
        leap.ifTrue(() => {
            maxDay = 29
        })
    })

    ((day < 1) || (day > maxDay)).ifTrue(() => {
        Error().signal()
    })

    date: {
        year: year
        month: month
        day: day
    }

    {
        kind: "localDate"
        value: date
    }
}

/// Answers a fresh TOML local-time node. Validates hour (0..23), minute (0..59), and
/// second (0..60); the fraction is `fractionCoefficient` over `fractionDigits` decimal
/// digits.
localTime: (hour, minute, second, fractionCoefficient, fractionDigits) => {
    ignoredHourValidation: 0 + hour
    ignoredMinuteValidation: 0 + minute
    ignoredSecondValidation: 0 + second
    ignoredFractionCoefficientValidation: 0 + fractionCoefficient
    ignoredFractionDigitsValidation: 0 + fractionDigits

    ((hour < 0) || (hour > 23)).ifTrue(() => {
        Error().signal()
    })
    ((minute < 0) || (minute > 59)).ifTrue(() => {
        Error().signal()
    })
    ((second < 0) || (second > 60)).ifTrue(() => {
        Error().signal()
    })
    (fractionCoefficient < 0).ifTrue(() => {
        Error().signal()
    })
    (fractionDigits < 0).ifTrue(() => {
        Error().signal()
    })

    (fractionDigits == 0).ifTrue(() => {
        (fractionCoefficient != 0).ifTrue(() => {
            Error().signal()
        })
    })
    (fractionDigits > 0).ifTrue(() => {
        limit: 1
        index: 0
        (() => index < fractionDigits).whileTrue(() => {
            limit = limit * 10
            index = index + 1
        })
        (fractionCoefficient >= limit).ifTrue(() => {
            Error().signal()
        })
    })

    fraction: {
        coefficient: fractionCoefficient
        digits: fractionDigits
    }
    time: {
        hour: hour
        minute: minute
        second: second
        fraction: fraction
    }

    {
        kind: "localTime"
        value: time
    }
}

/// Answers a fresh TOML local-date-time node.
/// Validates the year (1..9999), month, and day against the proleptic Gregorian
/// calendar.
/// Validates hour (0..23), minute (0..59), and second (0..60); the fraction is
/// `fractionCoefficient` over `fractionDigits` decimal digits.
localDateTime: (
    year,
    month,
    day,
    hour,
    minute,
    second,
    fractionCoefficient,
    fractionDigits
) => {
    ignoredYearValidation: 0 + year
    ignoredMonthValidation: 0 + month
    ignoredDayValidation: 0 + day
    ignoredHourValidation: 0 + hour
    ignoredMinuteValidation: 0 + minute
    ignoredSecondValidation: 0 + second
    ignoredFractionCoefficientValidation: 0 + fractionCoefficient
    ignoredFractionDigitsValidation: 0 + fractionDigits

    ((year < 1) || (year > 9999)).ifTrue(() => {
        Error().signal()
    })
    ((month < 1) || (month > 12)).ifTrue(() => {
        Error().signal()
    })

    maxDay: 31
    ((month == 4) || (month == 6) || (month == 9) || (month == 11)).ifTrue(() => {
        maxDay = 30
    })
    (month == 2).ifTrue(() => {
        leap: false
        (year.mod(4) == 0).ifTrue(() => {
            leap = true
        })
        (year.mod(100) == 0).ifTrue(() => {
            leap = false
        })
        (year.mod(400) == 0).ifTrue(() => {
            leap = true
        })
        maxDay = 28
        leap.ifTrue(() => {
            maxDay = 29
        })
    })
    ((day < 1) || (day > maxDay)).ifTrue(() => {
        Error().signal()
    })

    ((hour < 0) || (hour > 23)).ifTrue(() => {
        Error().signal()
    })
    ((minute < 0) || (minute > 59)).ifTrue(() => {
        Error().signal()
    })
    ((second < 0) || (second > 60)).ifTrue(() => {
        Error().signal()
    })
    (fractionCoefficient < 0).ifTrue(() => {
        Error().signal()
    })
    (fractionDigits < 0).ifTrue(() => {
        Error().signal()
    })

    (fractionDigits == 0).ifTrue(() => {
        (fractionCoefficient != 0).ifTrue(() => {
            Error().signal()
        })
    })
    (fractionDigits > 0).ifTrue(() => {
        limit: 1
        index: 0
        (() => index < fractionDigits).whileTrue(() => {
            limit = limit * 10
            index = index + 1
        })
        (fractionCoefficient >= limit).ifTrue(() => {
            Error().signal()
        })
    })

    fraction: {
        coefficient: fractionCoefficient
        digits: fractionDigits
    }
    dateTime: {
        year: year
        month: month
        day: day
        hour: hour
        minute: minute
        second: second
        fraction: fraction
    }

    {
        kind: "localDateTime"
        value: dateTime
    }
}

/// Answers a fresh TOML offset-date-time node.
/// Validates the year (1..9999), month, and day against the proleptic Gregorian
/// calendar.
/// Validates hour (0..23), minute (0..59), and second (0..60); the fraction is
/// `fractionCoefficient` over `fractionDigits` decimal digits.
/// `offsetMinutes` must lie in -1439..1439.
offsetDateTime: (
    year,
    month,
    day,
    hour,
    minute,
    second,
    fractionCoefficient,
    fractionDigits,
    offsetMinutes
) => {
    ignoredYearValidation: 0 + year
    ignoredMonthValidation: 0 + month
    ignoredDayValidation: 0 + day
    ignoredHourValidation: 0 + hour
    ignoredMinuteValidation: 0 + minute
    ignoredSecondValidation: 0 + second
    ignoredFractionCoefficientValidation: 0 + fractionCoefficient
    ignoredFractionDigitsValidation: 0 + fractionDigits
    ignoredOffsetValidation: 0 + offsetMinutes

    ((year < 1) || (year > 9999)).ifTrue(() => {
        Error().signal()
    })
    ((month < 1) || (month > 12)).ifTrue(() => {
        Error().signal()
    })

    maxDay: 31
    ((month == 4) || (month == 6) || (month == 9) || (month == 11)).ifTrue(() => {
        maxDay = 30
    })
    (month == 2).ifTrue(() => {
        leap: false
        (year.mod(4) == 0).ifTrue(() => {
            leap = true
        })
        (year.mod(100) == 0).ifTrue(() => {
            leap = false
        })
        (year.mod(400) == 0).ifTrue(() => {
            leap = true
        })
        maxDay = 28
        leap.ifTrue(() => {
            maxDay = 29
        })
    })
    ((day < 1) || (day > maxDay)).ifTrue(() => {
        Error().signal()
    })

    ((hour < 0) || (hour > 23)).ifTrue(() => {
        Error().signal()
    })
    ((minute < 0) || (minute > 59)).ifTrue(() => {
        Error().signal()
    })
    ((second < 0) || (second > 60)).ifTrue(() => {
        Error().signal()
    })
    (fractionCoefficient < 0).ifTrue(() => {
        Error().signal()
    })
    (fractionDigits < 0).ifTrue(() => {
        Error().signal()
    })

    (fractionDigits == 0).ifTrue(() => {
        (fractionCoefficient != 0).ifTrue(() => {
            Error().signal()
        })
    })
    (fractionDigits > 0).ifTrue(() => {
        limit: 1
        index: 0
        (() => index < fractionDigits).whileTrue(() => {
            limit = limit * 10
            index = index + 1
        })
        (fractionCoefficient >= limit).ifTrue(() => {
            Error().signal()
        })
    })

    ((offsetMinutes < -1439) || (offsetMinutes > 1439)).ifTrue(() => {
        Error().signal()
    })

    fraction: {
        coefficient: fractionCoefficient
        digits: fractionDigits
    }
    dateTime: {
        year: year
        month: month
        day: day
        hour: hour
        minute: minute
        second: second
        fraction: fraction
        offsetMinutes: offsetMinutes
    }

    {
        kind: "offsetDateTime"
        value: dateTime
    }
}

/// Answers a fresh TOML array node whose elements are `nodes`, in order.
/// Each element must be a TOML node: this constructor checks only each element's
/// immediate envelope, namely that its `kind` names one of the ten TOML semantic
/// kinds and that it carries a `value`; otherwise it signals an Error.
/// Success does not establish that an arbitrarily constructed tree is recursively
/// valid TOML; `TOML.encode` rejects any tree that cannot be validly encoded.
array: (...nodes) => {
    validateNode: (node) => {
        kind: node.kind
        valid: kind === "string"
        (kind === "integer").ifTrue(() => { valid = true })
        (kind === "float").ifTrue(() => { valid = true })
        (kind === "boolean").ifTrue(() => { valid = true })
        (kind === "offsetDateTime").ifTrue(() => { valid = true })
        (kind === "localDateTime").ifTrue(() => { valid = true })
        (kind === "localDate").ifTrue(() => { valid = true })
        (kind === "localTime").ifTrue(() => { valid = true })
        (kind === "array").ifTrue(() => { valid = true })
        (kind === "table").ifTrue(() => { valid = true })
        valid.ifFalse(() => {
            Error().signal()
        })
        ignoredValue: node.value
    }

    nodes.each((node) => {
        validateNode(node)
    })

    {
        kind: "array"
        value: nodes
    }
}

/// Answers a fresh TOML table node from alternating `name, node` arguments, in
/// order. Each name must be a String, names must not repeat, and every name must
/// be followed by its node; otherwise it signals an Error.
/// Each node is checked only for its immediate envelope, namely that its `kind`
/// names one of the ten TOML semantic kinds and that it carries a `value`.
/// Success does not establish that arbitrarily constructed descendants are
/// recursively valid TOML; `TOML.encode` retains full encodability validation.
table: (...nameNodePairs) => {
    validateNode: (node) => {
        kind: node.kind
        valid: kind === "string"
        (kind === "integer").ifTrue(() => { valid = true })
        (kind === "float").ifTrue(() => { valid = true })
        (kind === "boolean").ifTrue(() => { valid = true })
        (kind === "offsetDateTime").ifTrue(() => { valid = true })
        (kind === "localDateTime").ifTrue(() => { valid = true })
        (kind === "localDate").ifTrue(() => { valid = true })
        (kind === "localTime").ifTrue(() => { valid = true })
        (kind === "array").ifTrue(() => { valid = true })
        (kind === "table").ifTrue(() => { valid = true })
        valid.ifFalse(() => {
            Error().signal()
        })
        ignoredValue: node.value
    }

    result: Map()
    pendingName: null
    expectingName: true

    nameNodePairs.each((entry) => {
        wasExpectingName: expectingName

        wasExpectingName.ifTrue(() => {
            String.recognizes(entry).ifFalse(() => {
                Error().signal()
            })
            pendingName = entry
            expectingName = false
        })

        wasExpectingName.ifFalse(() => {
            validateNode(entry)
            result.containsKey(pendingName).ifTrue(() => {
                Error().signal()
            })
            result[pendingName] = entry
            pendingName = null
            expectingName = true
        })
    })

    expectingName.ifFalse(() => {
        Error().signal()
    })

    {
        kind: "table"
        value: result
    }
}

/// Encodes the table node `rootTable` as TOML document text; a root that is not
/// a table node or a tree that cannot be encoded signals an Error.
encode: (rootTable) => {
    output: Encoding.UTF8.encode("")

    emitText: (text) => {
        String.recognizes(text).ifFalse(() => {
            Error().signal()
        })
        Encoding.UTF8.encode(text).each((octet) => {
            output.add(octet)
        })
    }

    emitHexNibble: (digit) => {
        (digit < 10).ifTrue(() => {
            output.add(48 + digit)
        })
        (digit >= 10).ifTrue(() => {
            output.add(55 + digit)
        })
    }

    emitBasicString: (text) => {
        String.recognizes(text).ifFalse(() => {
            Error().signal()
        })

        output.add(34)
        Encoding.UTF8.encode(text).each((octet) => {
            handled: false

            (octet == 34).ifTrue(() => {
                output.add(92)
                output.add(34)
                handled = true
            })
            (octet == 92).ifTrue(() => {
                output.add(92)
                output.add(92)
                handled = true
            })

            handled.ifFalse(() => {
                control: octet < 32
                (octet == 127).ifTrue(() => {
                    control = true
                })
                control.ifTrue(() => {
                    output.add(92)
                    output.add(117)
                    output.add(48)
                    output.add(48)
                    emitHexNibble(octet.div(16))
                    emitHexNibble(octet.mod(16))
                    handled = true
                })
            })

            handled.ifFalse(() => {
                output.add(octet)
            })
        })
        output.add(34)
    }

    integerText: (value) => {
        Integer.recognizes(value).ifFalse(() => {
            Error().signal()
        })

        negative: value < 0
        magnitude: value
        negative.ifTrue(() => {
            magnitude = 0 - value
        })

        reversed: Encoding.UTF8.encode("")
        (magnitude == 0).ifTrue(() => {
            reversed.add(48)
        })
        (() => magnitude > 0).whileTrue(() => {
            reversed.add(48 + magnitude.mod(10))
            magnitude = magnitude.div(10)
        })

        result: Encoding.UTF8.encode("")
        negative.ifTrue(() => {
            result.add(45)
        })

        index: reversed.size() - 1
        (() => index >= 0).whileTrue(() => {
            result.add(reversed[index])
            index = index - 1
        })

        Encoding.UTF8.decode(result)
    }

    repeatZero: (count) => {
        result: ""
        remaining: count
        (() => remaining > 0).whileTrue(() => {
            result = result + "0"
            remaining = remaining - 1
        })
        result
    }

    powerInteger: (base, exponent) => {
        (exponent < 0).ifTrue(() => {
            fail()
        })

        result: 1
        factor: base
        remaining: exponent

        (() => remaining > 0).whileTrue(() => {
            (remaining.mod(2) == 1).ifTrue(() => {
                result = result * factor
            })
            remaining = remaining.div(2)
            (remaining > 0).ifTrue(() => {
                factor = factor * factor
            })
        })

        result
    }

    absoluteInteger: (value) => {
        result: value
        (result < 0).ifTrue(() => {
            result = 0 - result
        })
        result
    }

    decimalToken: (coefficient, decimalExponent) => {
        digits: integerText(coefficient)
        digitCount: digits.size()

        fixed: ""
        (decimalExponent >= 0).ifTrue(() => {
            fixed = digits + repeatZero(decimalExponent) + ".0"
        })

        (decimalExponent < 0).ifTrue(() => {
            point: digitCount + decimalExponent

            (point <= 0).ifTrue(() => {
                fixed = "0." + repeatZero(0 - point) + digits
            })

            (point > 0).ifTrue(() => {
                result: ""
                index: 0
                (() => index < digitCount).whileTrue(() => {
                    (index == point).ifTrue(() => {
                        result = result + "."
                    })
                    result = result + digits[index]
                    index = index + 1
                })
                fixed = result
            })
        })

        scientificExponent: decimalExponent + digitCount - 1
        scientific: digits[0]

        (digitCount > 1).ifTrue(() => {
            scientific = scientific + "."
            index: 1
            (() => index < digitCount).whileTrue(() => {
                scientific = scientific + digits[index]
                index = index + 1
            })
        })

        scientific = scientific + "e" + integerText(scientificExponent)

        result: fixed
        (scientific.size() < fixed.size()).ifTrue(() => {
            result = scientific
        })
        result
    }

    floatText: (value) => {
        Float.recognizes(value).ifFalse(() => {
            Error().signal()
        })

        positiveInfinity: 1.0 / 0.0
        negativeInfinity: 0.0 - positiveInfinity

        result: null
        handled: false

        (value == value).ifFalse(() => {
            result = "nan"
            handled = true
        })

        handled.ifFalse(() => {
            (value == positiveInfinity).ifTrue(() => {
                result = "inf"
                handled = true
            })
        })

        handled.ifFalse(() => {
            (value == negativeInfinity).ifTrue(() => {
                result = "-inf"
                handled = true
            })
        })

        handled.ifFalse(() => {
            (value == 0.0).ifTrue(() => {
                result = "0.0"
                ((1.0 / value) == negativeInfinity).ifTrue(() => {
                    result = "-0.0"
                })
                handled = true
            })
        })

        handled.ifFalse(() => {
            negative: value < 0.0
            magnitude: value
            negative.ifTrue(() => {
                magnitude = 0.0 - value
            })

            normalized: magnitude
            binaryExponent: 0

            (() => normalized >= 2.0).whileTrue(() => {
                normalized = normalized / 2.0
                binaryExponent = binaryExponent + 1
            })

            (() => normalized < 1.0).whileTrue(() => {
                normalized = normalized * 2.0
                binaryExponent = binaryExponent - 1
            })

            significand: Integer(normalized * 4503599627370496.0)
            binaryShift: binaryExponent - 52

            numerator: significand
            denominator: 1

            (binaryShift >= 0).ifTrue(() => {
                numerator = numerator * powerInteger(2, binaryShift)
            })

            (binaryShift < 0).ifTrue(() => {
                denominator = powerInteger(2, 0 - binaryShift)
            })

            decimalExponent: 0

            (numerator >= denominator).ifTrue(() => {
                threshold: denominator * 10
                (() => numerator >= threshold).whileTrue(() => {
                    decimalExponent = decimalExponent + 1
                    threshold = threshold * 10
                })
            })

            (numerator < denominator).ifTrue(() => {
                decimalExponent = -1
                scaledNumerator: numerator * 10
                (() => scaledNumerator < denominator).whileTrue(() => {
                    decimalExponent = decimalExponent - 1
                    scaledNumerator = scaledNumerator * 10
                })
            })

            coefficient: null
            coefficientExponent: 0
            significantDigits: 1

            (() => (coefficient === null) && (significantDigits <= 17)).whileTrue(() => {
                candidateExponent: decimalExponent - significantDigits + 1
                scaledNumerator: numerator
                scaledDenominator: denominator

                (candidateExponent >= 0).ifTrue(() => {
                    scaledDenominator =
                        scaledDenominator * powerInteger(10, candidateExponent)
                })

                (candidateExponent < 0).ifTrue(() => {
                    scaledNumerator =
                        scaledNumerator * powerInteger(10, 0 - candidateExponent)
                })

                quotient: scaledNumerator.div(scaledDenominator)
                remainder: scaledNumerator.mod(scaledDenominator)
                rounded: quotient
                twiceRemainder: remainder * 2

                (twiceRemainder > scaledDenominator).ifTrue(() => {
                    rounded = rounded + 1
                })

                (twiceRemainder == scaledDenominator).ifTrue(() => {
                    (rounded.mod(2) == 1).ifTrue(() => {
                        rounded = rounded + 1
                    })
                })

                bestCandidate: null
                bestDistance: null

                roundTrips: (candidate) => {
                    candidateFloat: null

                    (candidateExponent >= 0).ifTrue(() => {
                        candidateFloat =
                            Float(candidate * powerInteger(10, candidateExponent))
                    })

                    (candidateExponent < 0).ifTrue(() => {
                        candidateFloat =
                            Float(candidate / powerInteger(10, 0 - candidateExponent))
                    })

                    candidateFloat == magnitude
                }

                consider: (candidate) => {
                    (candidate > 0).ifTrue(() => {
                        roundTrips(candidate).ifTrue(() => {
                            distance:
                                absoluteInteger(
                                    scaledNumerator - candidate * scaledDenominator
                                )

                            better: bestCandidate === null

                            (bestCandidate === null).ifFalse(() => {
                                (distance < bestDistance).ifTrue(() => {
                                    better = true
                                })

                                (distance == bestDistance).ifTrue(() => {
                                    candidateEven: candidate.mod(2) == 0
                                    bestOdd: bestCandidate.mod(2) == 1
                                    (candidateEven && bestOdd).ifTrue(() => {
                                        better = true
                                    })
                                })
                            })

                            better.ifTrue(() => {
                                bestCandidate = candidate
                                bestDistance = distance
                            })
                        })
                    })
                }

                consider(rounded)
                consider(rounded - 1)
                consider(rounded + 1)

                (bestCandidate === null).ifFalse(() => {
                    coefficient = bestCandidate
                    coefficientExponent = candidateExponent
                })

                significantDigits = significantDigits + 1
            })

            (coefficient === null).ifTrue(() => {
                fail()
            })

            (() => coefficient.mod(10) == 0).whileTrue(() => {
                coefficient = coefficient.div(10)
                coefficientExponent = coefficientExponent + 1
            })

            result = decimalToken(coefficient, coefficientExponent)
            negative.ifTrue(() => {
                result = "-" + result
            })
        })

        result
    }

    paddedIntegerText: (value, width) => {
        text: integerText(value)
        result: text
        (() => result.size() < width).whileTrue(() => {
            result = "0" + result
        })
        result
    }

    fractionText: (fraction) => {
        coefficient: fraction.coefficient
        digits: fraction.digits

        Integer.recognizes(coefficient).ifFalse(() => {
            Error().signal()
        })
        Integer.recognizes(digits).ifFalse(() => {
            Error().signal()
        })

        result: ""
        (digits > 0).ifTrue(() => {
            raw: Encoding.UTF8.encode(integerText(coefficient))
            buffer: Encoding.UTF8.encode(".")
            padding: digits - raw.size()
            (() => padding > 0).whileTrue(() => {
                buffer.add(48)
                padding = padding - 1
            })
            raw.each((octet) => {
                buffer.add(octet)
            })
            result = Encoding.UTF8.decode(buffer)
        })
        result
    }

    dateText: (value) => {
        ignoredValidation: localDate(value.year, value.month, value.day)
        paddedIntegerText(value.year, 4) +
            "-" +
            paddedIntegerText(value.month, 2) +
            "-" +
            paddedIntegerText(value.day, 2)
    }

    timeText: (value) => {
        ignoredValidation:
            localTime(
                value.hour,
                value.minute,
                value.second,
                value.fraction.coefficient,
                value.fraction.digits
            )

        paddedIntegerText(value.hour, 2) +
            ":" +
            paddedIntegerText(value.minute, 2) +
            ":" +
            paddedIntegerText(value.second, 2) +
            fractionText(value.fraction)
    }

    localDateTimeText: (value) => {
        ignoredValidation:
            localDateTime(
                value.year,
                value.month,
                value.day,
                value.hour,
                value.minute,
                value.second,
                value.fraction.coefficient,
                value.fraction.digits
            )

        datePart: {
            year: value.year
            month: value.month
            day: value.day
        }

        timePart: {
            hour: value.hour
            minute: value.minute
            second: value.second
            fraction: value.fraction
        }

        dateText(datePart) + "T" + timeText(timePart)
    }

    offsetDateTimeText: (value) => {
        ignoredValidation:
            offsetDateTime(
                value.year,
                value.month,
                value.day,
                value.hour,
                value.minute,
                value.second,
                value.fraction.coefficient,
                value.fraction.digits,
                value.offsetMinutes
            )

        datePart: {
            year: value.year
            month: value.month
            day: value.day
        }

        timePart: {
            hour: value.hour
            minute: value.minute
            second: value.second
            fraction: value.fraction
        }

        offsetText: "Z"
        (value.offsetMinutes == 0).ifFalse(() => {
            sign: "+"
            magnitude: value.offsetMinutes
            (magnitude < 0).ifTrue(() => {
                sign = "-"
                magnitude = 0 - magnitude
            })

            offsetText =
                sign +
                paddedIntegerText(magnitude.div(60), 2) +
                ":" +
                paddedIntegerText(magnitude.mod(60), 2)
        })

        dateText(datePart) + "T" + timeText(timePart) + offsetText
    }

    active: IdentityMap()
    topFrame: null

    snapshotTableEntries: (tableValue) => {
        entries: Map()
        count: 0

        tableValue.each((name, child) => {
            String.recognizes(name).ifFalse(() => {
                Error().signal()
            })
            entries[count] = {
                name: name
                child: child
            }
            count = count + 1
        })

        {
            entries: entries
            count: count
        }
    }

    pushValue: (node, parentFrame) => {
        kind: node.kind
        value: node.value
        handled: false

        (kind === "string").ifTrue(() => {
            ignoredValidation: string(value)
            emitBasicString(value)
            handled = true
        })

        (kind === "integer").ifTrue(() => {
            ignoredValidation: integer(value)
            emitText(integerText(value))
            handled = true
        })

        (kind === "float").ifTrue(() => {
            ignoredValidation: float(value)
            emitText(floatText(value))
            handled = true
        })

        (kind === "boolean").ifTrue(() => {
            ignoredValidation: boolean(value)
            (value === true).ifTrue(() => {
                emitText("true")
            })
            (value === false).ifTrue(() => {
                emitText("false")
            })
            handled = true
        })

        (kind === "localDate").ifTrue(() => {
            emitText(dateText(value))
            handled = true
        })

        (kind === "localTime").ifTrue(() => {
            emitText(timeText(value))
            handled = true
        })

        (kind === "localDateTime").ifTrue(() => {
            emitText(localDateTimeText(value))
            handled = true
        })

        (kind === "offsetDateTime").ifTrue(() => {
            emitText(offsetDateTimeText(value))
            handled = true
        })

        (kind === "array").ifTrue(() => {
            active.containsKey(node).ifTrue(() => {
                fail()
            })
            active[node] = true

            output.add(91)
            topFrame = {
                frameKind: "array"
                parent: parentFrame
                node: node
                values: value
                count: value.size()
                index: 0
            }
            handled = true
        })

        (kind === "table").ifTrue(() => {
            active.containsKey(node).ifTrue(() => {
                fail()
            })
            active[node] = true

            snapshot: snapshotTableEntries(value)
            output.add(123)
            topFrame = {
                frameKind: "table"
                parent: parentFrame
                node: node
                entries: snapshot.entries
                count: snapshot.count
                index: 0
            }
            handled = true
        })

        handled.ifFalse(() => {
            fail()
        })
    }

    (rootTable.kind === "table").ifFalse(() => {
        fail()
    })

    rootSnapshot: snapshotTableEntries(rootTable.value)
    active[rootTable] = true
    topFrame = {
        frameKind: "root"
        parent: null
        node: rootTable
        entries: rootSnapshot.entries
        count: rootSnapshot.count
        index: 0
    }

    running: true
    (() => running).whileTrue(() => {
        frame: topFrame
        frameKind: frame.frameKind

        (frameKind == "root").ifTrue(() => {
            (frame.index >= frame.count).ifTrue(() => {
                (frame.count > 0).ifTrue(() => {
                    output.add(10)
                })
                active.remove(frame.node)
                running = false
            })

            (frame.index < frame.count).ifTrue(() => {
                (frame.index > 0).ifTrue(() => {
                    output.add(10)
                })

                entry: frame.entries[frame.index]
                frame.index = frame.index + 1

                emitBasicString(entry.name)
                emitText(" = ")
                pushValue(entry.child, frame)
            })
        })

        (frameKind == "array").ifTrue(() => {
            (frame.index >= frame.count).ifTrue(() => {
                output.add(93)
                active.remove(frame.node)
                topFrame = frame.parent
            })

            (frame.index < frame.count).ifTrue(() => {
                (frame.index > 0).ifTrue(() => {
                    emitText(", ")
                })

                child: frame.values[frame.index]
                frame.index = frame.index + 1
                pushValue(child, frame)
            })
        })

        (frameKind == "table").ifTrue(() => {
            (frame.index >= frame.count).ifTrue(() => {
                output.add(125)
                active.remove(frame.node)
                topFrame = frame.parent
            })

            (frame.index < frame.count).ifTrue(() => {
                (frame.index > 0).ifTrue(() => {
                    emitText(", ")
                })

                entry: frame.entries[frame.index]
                frame.index = frame.index + 1

                emitBasicString(entry.name)
                emitText(" = ")
                pushValue(entry.child, frame)
            })
        })
    })

    Encoding.UTF8.decode(output)
}


/// Parses one complete TOML document into its root table node using the TOML
/// specification version named by `version`, either `"1.0"` or `"1.1"`; any other
/// `version` or invalid text signals an Error. Both versions share one parser: TOML
/// 1.0 additionally rejects the `\e` and `\xHH` escapes, inline tables that span
/// lines or end with a trailing comma, and times without seconds.
parseDialect: (text, version) => {
    String.recognizes(text).ifFalse(() => {
        Error().signal()
    })
    String.recognizes(version).ifFalse(() => {
        Error().signal()
    })
    toml11: version == "1.1"
    (toml11 || (version == "1.0")).ifFalse(() => {
        Error().signal()
    })

    publicLocalDate: localDate
    publicLocalTime: localTime
    publicLocalDateTime: localDateTime
    publicOffsetDateTime: offsetDateTime

    syntaxNode: (kind, value) => {
        result: {
            kind: kind
            value: value
        }
        result
    }

    syntaxKeyPath: (text) => {
        String.recognizes(text).ifFalse(() => {
            Error().signal()
        })
        source: Encoding.UTF8.encode(text)
        index: 0
        length: source.size()

        peek: () => {
            result: -1
            (index < length).ifTrue(() => {
                result = source[index]
            })
            result
        }

        take: () => {
            (index >= length).ifTrue(() => {
                fail()
            })
            result: source[index]
            index = index + 1
            result
        }

        skipSpaces: () => {
            scanning: true
            (() => scanning && (index < length)).whileTrue(() => {
                octet: source[index]
                whitespace: octet == 32
                (octet == 9).ifTrue(() => {
                    whitespace = true
                })
                whitespace.ifTrue(() => {
                    index = index + 1
                })
                whitespace.ifFalse(() => {
                    scanning = false
                })
            })
        }

        hexDigit: (octet) => {
            result: -1
            (octet >= 48).ifTrue(() => {
                (octet <= 57).ifTrue(() => {
                    result = octet - 48
                })
            })
            (result < 0).ifTrue(() => {
                (octet >= 65).ifTrue(() => {
                    (octet <= 70).ifTrue(() => {
                        result = octet - 55
                    })
                })
            })
            (result < 0).ifTrue(() => {
                (octet >= 97).ifTrue(() => {
                    (octet <= 102).ifTrue(() => {
                        result = octet - 87
                    })
                })
            })
            result
        }

        appendScalarUtf8: (buffer, scalar) => {
            invalid: scalar < 0
            (scalar > 1114111).ifTrue(() => {
                invalid = true
            })
            (scalar >= 55296).ifTrue(() => {
                (scalar <= 57343).ifTrue(() => {
                    invalid = true
                })
            })
            invalid.ifTrue(() => {
                fail()
            })

            handled: false
            (scalar <= 127).ifTrue(() => {
                buffer.add(scalar)
                handled = true
            })
            handled.ifFalse(() => {
                (scalar <= 2047).ifTrue(() => {
                    buffer.add(192 + scalar.div(64))
                    buffer.add(128 + scalar.mod(64))
                    handled = true
                })
            })
            handled.ifFalse(() => {
                (scalar <= 65535).ifTrue(() => {
                    buffer.add(224 + scalar.div(4096))
                    buffer.add(128 + scalar.div(64).mod(64))
                    buffer.add(128 + scalar.mod(64))
                    handled = true
                })
            })
            handled.ifFalse(() => {
                buffer.add(240 + scalar.div(262144))
                buffer.add(128 + scalar.div(4096).mod(64))
                buffer.add(128 + scalar.div(64).mod(64))
                buffer.add(128 + scalar.mod(64))
            })
        }

        parseUnicodeEscape: (digits, buffer) => {
            scalar: 0
            remaining: digits

            consume: null
            consume = () => {
                (remaining > 0).ifTrue(() => {
                    digit: hexDigit(take())
                    (digit < 0).ifTrue(() => {
                        fail()
                    })
                    scalar = scalar * 16 + digit
                    remaining = remaining - 1
                    consume()
                })
            }

            consume()
            appendScalarUtf8(buffer, scalar)
        }

        parseBasicKey: () => {
            (take() == 34).ifFalse(() => {
                fail()
            })
            buffer: Encoding.UTF8.encode("")
            done: false

            (() => done === false).whileTrue(() => {
                octet: take()
                    (octet == 34).ifTrue(() => {
                        done = true
                    })

                    done.ifFalse(() => {
                        (octet == 92).ifTrue(() => {
                            escape: take()
                            handled: false
                            (escape == 98).ifTrue(() => {
                                buffer.add(8)
                                handled = true
                            })
                            (escape == 116).ifTrue(() => {
                                buffer.add(9)
                                handled = true
                            })
                            (escape == 110).ifTrue(() => {
                                buffer.add(10)
                                handled = true
                            })
                            (escape == 102).ifTrue(() => {
                                buffer.add(12)
                                handled = true
                            })
                            (escape == 114).ifTrue(() => {
                                buffer.add(13)
                                handled = true
                            })
                            (toml11 && (escape == 101)).ifTrue(() => {
                                buffer.add(27)
                                handled = true
                            })
                            (toml11 && (escape == 120)).ifTrue(() => {
                                parseUnicodeEscape(2, buffer)
                                handled = true
                            })
                            (escape == 34).ifTrue(() => {
                                buffer.add(34)
                                handled = true
                            })
                            (escape == 92).ifTrue(() => {
                                buffer.add(92)
                                handled = true
                            })
                            (escape == 117).ifTrue(() => {
                                parseUnicodeEscape(4, buffer)
                                handled = true
                            })
                            (escape == 85).ifTrue(() => {
                                parseUnicodeEscape(8, buffer)
                                handled = true
                            })
                            handled.ifFalse(() => {
                                fail()
                            })
                        })

                        (octet == 92).ifFalse(() => {
                            invalidControl: octet < 32
                            (octet == 127).ifTrue(() => {
                                invalidControl = true
                            })
                            (octet == 9).ifTrue(() => {
                                invalidControl = false
                            })
                            invalidControl.ifTrue(() => {
                                fail()
                            })
                            buffer.add(octet)
                        })
                    })
            })
            Encoding.UTF8.decode(buffer)
        }

        parseLiteralKey: () => {
            (take() == 39).ifFalse(() => {
                fail()
            })
            buffer: Encoding.UTF8.encode("")
            done: false

            (() => done === false).whileTrue(() => {
                octet: take()
                    (octet == 39).ifTrue(() => {
                        done = true
                    })
                    done.ifFalse(() => {
                        invalidControl: octet < 32
                        (octet == 127).ifTrue(() => {
                            invalidControl = true
                        })
                        (octet == 9).ifTrue(() => {
                            invalidControl = false
                        })
                        invalidControl.ifTrue(() => {
                            fail()
                        })
                        buffer.add(octet)
                    })
            })
            Encoding.UTF8.decode(buffer)
        }

        isBareKeyOctet: (octet) => {
            result: false
            (octet >= 48).ifTrue(() => {
                (octet <= 57).ifTrue(() => { result = true })
            })
            (octet >= 65).ifTrue(() => {
                (octet <= 90).ifTrue(() => { result = true })
            })
            (octet >= 97).ifTrue(() => {
                (octet <= 122).ifTrue(() => { result = true })
            })
            (octet == 95).ifTrue(() => { result = true })
            (octet == 45).ifTrue(() => { result = true })
            result
        }

        parseBareKey: () => {
            buffer: Encoding.UTF8.encode("")
            scanning: true

            (() => scanning && (index < length)).whileTrue(() => {
                octet: source[index]
                validBare: isBareKeyOctet(octet)
                validBare.ifTrue(() => {
                    buffer.add(octet)
                    index = index + 1
                })
                validBare.ifFalse(() => {
                    scanning = false
                })
            })

            (buffer.size() == 0).ifTrue(() => {
                fail()
            })
            Encoding.UTF8.decode(buffer)
        }

        parsePart: () => {
            skipSpaces()
            first: peek()
            result: null

            (first == 34).ifTrue(() => {
                result = parseBasicKey()
            })
            (first == 39).ifTrue(() => {
                result = parseLiteralKey()
            })
            (first == 34).ifFalse(() => {
                (first == 39).ifFalse(() => {
                    result = parseBareKey()
                })
            })

            result
        }

        pathEntries: Map()
        pathCount: 0

        appendPathPart: (part) => {
            pathEntries[pathCount] = part
            pathCount = pathCount + 1
        }

        appendPathPart(parsePart())
        more: true

        (() => more).whileTrue(() => {
            skipSpaces()

            (index < length).ifTrue(() => {
                (source[index] == 46).ifFalse(() => {
                    fail()
                })
                index = index + 1
                appendPathPart(parsePart())
            })

            (index >= length).ifTrue(() => {
                more = false
            })
        })

        skipSpaces()
        (index == length).ifFalse(() => {
            fail()
        })

        {
            entries: pathEntries
            count: pathCount
        }
    }

    syntaxValue: (text) => {
        String.recognizes(text).ifFalse(() => {
            Error().signal()
        })
        source: Encoding.UTF8.encode(text)
        index: 0
        length: source.size()

        peek: () => {
            result: -1
            (index < length).ifTrue(() => {
                result = source[index]
            })
            result
        }

        take: () => {
            (index >= length).ifTrue(() => {
                fail()
            })
            result: source[index]
            index = index + 1
            result
        }

        isSpace: (octet) => {
            result: octet == 32
            (octet == 9).ifTrue(() => {
                result = true
            })
            result
        }

        isNewlineStart: (octet) => {
            result: octet == 10
            (octet == 13).ifTrue(() => {
                result = true
            })
            result
        }

        consumeNewline: () => {
            octet: take()
            valid: octet == 10
            (octet == 13).ifTrue(() => {
                valid = true
                (peek() == 10).ifFalse(() => {
                    fail()
                })
                take()
            })
            valid.ifFalse(() => {
                fail()
            })
        }

        skipSpaces: () => {
            scanning: true
            (() => scanning && (index < length)).whileTrue(() => {
                whitespace: isSpace(source[index])
                whitespace.ifTrue(() => {
                    index = index + 1
                })
                whitespace.ifFalse(() => {
                    scanning = false
                })
            })
        }

        skipComment: () => {
            scanning: true
            (() => scanning && (index < length)).whileTrue(() => {
                octet: source[index]
                newline: isNewlineStart(octet)
                newline.ifTrue(() => {
                    scanning = false
                })
                newline.ifFalse(() => {
                    invalidControl: octet < 32
                    (octet == 127).ifTrue(() => {
                        invalidControl = true
                    })
                    (octet == 9).ifTrue(() => {
                        invalidControl = false
                    })
                    invalidControl.ifTrue(() => {
                        fail()
                    })
                    index = index + 1
                })
            })
        }

        skipArrayTrivia: () => {
            progressed: true
            (() => progressed).whileTrue(() => {
                progressed = false
                (index < length).ifTrue(() => {
                    octet: source[index]
                    isSpace(octet).ifTrue(() => {
                        index = index + 1
                        progressed = true
                    })
                    isNewlineStart(octet).ifTrue(() => {
                        consumeNewline()
                        progressed = true
                    })
                    (octet == 35).ifTrue(() => {
                        index = index + 1
                        skipComment()
                        progressed = true
                    })
                })
            })
        }

        // TOML 1.0 inline tables are single-line, so only spaces and tabs may
        // separate their tokens; TOML 1.1 also admits newlines and comments.
        skipInlineTableTrivia: () => {
            toml11.ifTrue(() => {
                skipArrayTrivia()
            })
            toml11.ifFalse(() => {
                skipSpaces()
            })
        }

        hexDigit: (octet) => {
            result: -1
            (octet >= 48).ifTrue(() => {
                (octet <= 57).ifTrue(() => {
                    result = octet - 48
                })
            })
            (result < 0).ifTrue(() => {
                (octet >= 65).ifTrue(() => {
                    (octet <= 70).ifTrue(() => {
                        result = octet - 55
                    })
                })
            })
            (result < 0).ifTrue(() => {
                (octet >= 97).ifTrue(() => {
                    (octet <= 102).ifTrue(() => {
                        result = octet - 87
                    })
                })
            })
            result
        }

        appendScalarUtf8: (buffer, scalar) => {
            invalid: scalar < 0
            (scalar > 1114111).ifTrue(() => {
                invalid = true
            })
            (scalar >= 55296).ifTrue(() => {
                (scalar <= 57343).ifTrue(() => {
                    invalid = true
                })
            })
            invalid.ifTrue(() => {
                fail()
            })

            handled: false
            (scalar <= 127).ifTrue(() => {
                buffer.add(scalar)
                handled = true
            })
            handled.ifFalse(() => {
                (scalar <= 2047).ifTrue(() => {
                    buffer.add(192 + scalar.div(64))
                    buffer.add(128 + scalar.mod(64))
                    handled = true
                })
            })
            handled.ifFalse(() => {
                (scalar <= 65535).ifTrue(() => {
                    buffer.add(224 + scalar.div(4096))
                    buffer.add(128 + scalar.div(64).mod(64))
                    buffer.add(128 + scalar.mod(64))
                    handled = true
                })
            })
            handled.ifFalse(() => {
                buffer.add(240 + scalar.div(262144))
                buffer.add(128 + scalar.div(4096).mod(64))
                buffer.add(128 + scalar.div(64).mod(64))
                buffer.add(128 + scalar.mod(64))
            })
        }

        parseUnicodeEscape: (digits, buffer) => {
            scalar: 0
            remaining: digits

            consume: null
            consume = () => {
                (remaining > 0).ifTrue(() => {
                    digit: hexDigit(take())
                    (digit < 0).ifTrue(() => {
                        fail()
                    })
                    scalar = scalar * 16 + digit
                    remaining = remaining - 1
                    consume()
                })
            }

            consume()
            appendScalarUtf8(buffer, scalar)
        }

        parseBasicString: (multiline) => {
            multiline.ifFalse(() => {
                (take() == 34).ifFalse(() => {
                    fail()
                })
            })

            multiline.ifTrue(() => {
                (take() == 34).ifFalse(() => { fail() })
                (take() == 34).ifFalse(() => { fail() })
                (take() == 34).ifFalse(() => { fail() })
                isNewlineStart(peek()).ifTrue(() => {
                    consumeNewline()
                })
            })

            buffer: Encoding.UTF8.encode("")
            done: false

            countQuotes: (initial) => {
                count: initial
                (() => peek() == 34).whileTrue(() => {
                    index = index + 1
                    count = count + 1
                })
                count
            }

            skipContinuationWhitespace: () => {
                scanning: true
                (() => scanning && (index < length)).whileTrue(() => {
                    octet: source[index]
                    whitespace: isSpace(octet)
                    isNewlineStart(octet).ifTrue(() => {
                        whitespace = true
                    })

                    whitespace.ifTrue(() => {
                        isNewlineStart(octet).ifTrue(() => {
                            consumeNewline()
                        })
                        isNewlineStart(octet).ifFalse(() => {
                            index = index + 1
                        })
                    })
                    whitespace.ifFalse(() => {
                        scanning = false
                    })
                })
            }

            (() => done === false).whileTrue(() => {
                octet: take()
                ordinaryOctet: true

                    multiline.ifFalse(() => {
                        (octet == 34).ifTrue(() => {
                            done = true
                        })
                    })

                    multiline.ifTrue(() => {
                        (octet == 34).ifTrue(() => {
                            ordinaryOctet = false
                            quoteCount: countQuotes(1)

                            (quoteCount >= 3).ifTrue(() => {
                                (quoteCount > 5).ifTrue(() => {
                                    fail()
                                })
                                extra: quoteCount - 3
                                (extra > 0).ifTrue(() => {
                                    buffer.add(34)
                                })
                                (extra > 1).ifTrue(() => {
                                    buffer.add(34)
                                })
                                done = true
                            })

                            (quoteCount < 3).ifTrue(() => {
                                buffer.add(34)
                                (quoteCount == 2).ifTrue(() => {
                                    buffer.add(34)
                                })
                            })
                        })
                    })

                    done.ifFalse(() => {
                        ordinaryOctet.ifTrue(() => {
                            (octet == 92).ifTrue(() => {
                                continuation: false

                                multiline.ifTrue(() => {
                                    look: index
                                    seeking: true
                                    sawNewline: false

                                    (() => seeking && (look < length)).whileTrue(() => {
                                        candidate: source[look]
                                        candidateSpace: isSpace(candidate)
                                        candidateNewline: isNewlineStart(candidate)

                                        candidateSpace.ifTrue(() => {
                                            look = look + 1
                                        })
                                        candidateNewline.ifTrue(() => {
                                            sawNewline = true
                                            seeking = false
                                        })
                                        (candidateSpace || candidateNewline).ifFalse(() => {
                                            seeking = false
                                        })
                                    })
                                    (look >= length).ifTrue(() => {
                                        seeking = false
                                    })
                                    sawNewline.ifTrue(() => {
                                        continuation = true
                                    })
                                })

                                continuation.ifTrue(() => {
                                    (() => isSpace(peek())).whileTrue(() => {
                                        index = index + 1
                                    })
                                    isNewlineStart(peek()).ifFalse(() => {
                                        fail()
                                    })
                                    consumeNewline()
                                    skipContinuationWhitespace()
                                })

                                continuation.ifFalse(() => {
                                    escape: take()
                                    handled: false

                                    (escape == 98).ifTrue(() => {
                                        buffer.add(8)
                                        handled = true
                                    })
                                    (escape == 116).ifTrue(() => {
                                        buffer.add(9)
                                        handled = true
                                    })
                                    (escape == 110).ifTrue(() => {
                                        buffer.add(10)
                                        handled = true
                                    })
                                    (escape == 102).ifTrue(() => {
                                        buffer.add(12)
                                        handled = true
                                    })
