                    (tokenLength == 10).ifTrue(() => {
                        result.value =
                            publicLocalDate(yearPart.value, monthPart.value, dayPart.value)
                        result.valid = true
                    })

                    (tokenLength > 10).ifTrue(() => {
                        delimiter: token[10]
                        validDelimiter: delimiter == 84
                        (delimiter == 116).ifTrue(() => { validDelimiter = true })
                        (delimiter == 32).ifTrue(() => { validDelimiter = true })

                        validDelimiter.ifTrue(() => {
                            parsedTime: timeAt(token, 11)
                            parsedTime.valid.ifTrue(() => {
                                position: parsedTime.position

                                (position == tokenLength).ifTrue(() => {
                                    result.value =
                                        publicLocalDateTime(
                                            yearPart.value,
                                            monthPart.value,
                                            dayPart.value,
                                            parsedTime.hour,
                                            parsedTime.minute,
                                            parsedTime.second,
                                            parsedTime.fractionCoefficient,
                                            parsedTime.fractionDigits
                                        )
                                    result.valid = true
                                })

                                (position < tokenLength).ifTrue(() => {
                                    offsetMinutes: 0
                                    offsetValid: false
                                    offsetEnd: position

                                    ((token[position] == 90) ||
                                        (token[position] == 122)).ifTrue(() => {
                                        offsetValid = true
                                        offsetEnd = position + 1
                                    })

                                    ((token[position] == 43) ||
                                        (token[position] == 45)).ifTrue(() => {
                                        (position + 5 < tokenLength).ifTrue(() => {
                                            (token[position + 3] == 58).ifTrue(() => {
                                                offsetHour: twoDigitsAt(token, position + 1)
                                                offsetMinute: twoDigitsAt(token, position + 4)

                                                (offsetHour.valid && offsetMinute.valid).ifTrue(() => {
                                                    ((offsetHour.value <= 23) &&
                                                        (offsetMinute.value <= 59)).ifTrue(() => {
                                                        offsetMinutes =
                                                            offsetHour.value * 60 +
                                                            offsetMinute.value
                                                        (token[position] == 45).ifTrue(() => {
                                                            offsetMinutes =
                                                                0 - offsetMinutes
                                                        })
                                                        offsetEnd = position + 6
                                                        offsetValid = true
                                                    })
                                                })
                                            })
                                        })
                                    })

                                    (offsetValid && (offsetEnd == tokenLength)).ifTrue(() => {
                                        result.value =
                                            publicOffsetDateTime(
                                                yearPart.value,
                                                monthPart.value,
                                                dayPart.value,
                                                parsedTime.hour,
                                                parsedTime.minute,
                                                parsedTime.second,
                                                parsedTime.fractionCoefficient,
                                                parsedTime.fractionDigits,
                                                offsetMinutes
                                            )
                                        result.valid = true
                                    })
                                })
                            })
                        })
                    })
                })
            })

            dateShape.ifFalse(() => {
                parsedTime: timeAt(token, 0)
                (parsedTime.valid && (parsedTime.position == tokenLength)).ifTrue(() => {
                    result.value =
                        publicLocalTime(
                            parsedTime.hour,
                            parsedTime.minute,
                            parsedTime.second,
                            parsedTime.fractionCoefficient,
                            parsedTime.fractionDigits
                        )
                    result.valid = true
                })
            })

            result
        }

        isBareTerminator: (octet) => {
            result: octet < 0
            isSpace(octet).ifTrue(() => { result = true })
            isNewlineStart(octet).ifTrue(() => { result = true })
            (octet == 35).ifTrue(() => { result = true })
            (octet == 44).ifTrue(() => { result = true })
            (octet == 93).ifTrue(() => { result = true })
            (octet == 125).ifTrue(() => { result = true })
            result
        }

        parseBareValue: () => {
            token: Encoding.UTF8.encode("")

            gathering: true
            (() => gathering).whileTrue(() => {
                octet: peek()
                terminator: octet < 0
                isNewlineStart(octet).ifTrue(() => { terminator = true })
                (octet == 35).ifTrue(() => { terminator = true })
                (octet == 44).ifTrue(() => { terminator = true })
                (octet == 93).ifTrue(() => { terminator = true })
                (octet == 125).ifTrue(() => { terminator = true })

                terminator.ifTrue(() => {
                    gathering = false
                })
                terminator.ifFalse(() => {
                    invalidControl: octet < 32
                    (octet == 9).ifTrue(() => {
                        invalidControl = false
                    })
                    (octet == 127).ifTrue(() => {
                        invalidControl = true
                    })
                    invalidControl.ifTrue(() => {
                        fail()
                    })
                    token.add(take())
                })
            })
            (token.size() == 0).ifTrue(() => {
                fail()
            })

            right: token.size()
            trimming: true
            (() => trimming && (right > 0)).whileTrue(() => {
                whitespace: isSpace(token[right - 1])
                whitespace.ifTrue(() => {
                    right = right - 1
                })
                whitespace.ifFalse(() => {
                    trimming = false
                })
            })

            trimmed: Encoding.UTF8.encode("")
            copyIndex: 0
            (() => copyIndex < right).whileTrue(() => {
                trimmed.add(token[copyIndex])
                copyIndex = copyIndex + 1
            })

            (trimmed.size() == 0).ifTrue(() => {
                fail()
            })

            decoded: Encoding.UTF8.decode(trimmed)
            result: null

            (decoded == "true").ifTrue(() => {
                result = syntaxNode("boolean", true)
            })
            (decoded == "false").ifTrue(() => {
                result = syntaxNode("boolean", false)
            })

            (result === null).ifTrue(() => {
                integer: integerFromToken(trimmed)
                integer.valid.ifTrue(() => {
                    result = syntaxNode("integer", integer.value)
                })
            })

            (result === null).ifTrue(() => {
                temporal: temporalFromToken(trimmed)
                temporal.valid.ifTrue(() => {
                    result = temporal.value
                })
            })

            (result === null).ifTrue(() => {
                floating: floatFromToken(trimmed)
                floating.valid.ifTrue(() => {
                    result = syntaxNode("float", floating.value)
                })
            })

            (result === null).ifTrue(() => {
                fail()
            })

            result
        }

        topFrame: null
        depth: 0
        rootValue: null
        rootDone: false

        pushArrayFrame: () => {
            frame: {
                parent: topFrame
                kind: "array"
                phase: "valueOrEnd"
                chunks: Map()
                maxLevel: -1
            }
            topFrame = frame
            depth = depth + 1
        }

        pushInlineTableFrame: () => {
            frame: {
                parent: topFrame
                kind: "inlineTable"
                phase: "keyOrEnd"
                entries: Map()
                dottedTables: IdentityMap()
                pendingPath: null
            }
            topFrame = frame
            depth = depth + 1
        }

        appendArrayValue: (frame, valueNode) => {
            carryFrameChunk(frame, Array(valueNode), 0)
            frame.phase = "commaOrEnd"
        }

        acceptValue: (valueNode) => {
            (depth == 0).ifTrue(() => {
                rootDone.ifTrue(() => { fail() })
                rootValue = valueNode
                rootDone = true
            })

            (depth > 0).ifTrue(() => {
                frame: topFrame

                (frame.kind == "array").ifTrue(() => {
                    (frame.phase == "awaitValue").ifFalse(() => { fail() })
                    appendArrayValue(frame, valueNode)
                })

                (frame.kind == "inlineTable").ifTrue(() => {
                    (frame.phase == "awaitValue").ifFalse(() => { fail() })
                    putPath(
                        frame.entries,
                        frame.pendingPath,
                        frame.dottedTables,
                        valueNode
                    )
                    frame.pendingPath = null
                    frame.phase = "commaOrEnd"
                })
            })
        }

        closeArrayFrame: () => {
            frame: topFrame
            (frame.kind == "array").ifFalse(() => { fail() })
            validPhase: frame.phase == "valueOrEnd"
            (frame.phase == "commaOrEnd").ifTrue(() => { validPhase = true })
            validPhase.ifFalse(() => { fail() })

            materialized: collectFrameChunks(frame, frame.maxLevel, Array())
            valueNode: syntaxNode("array", materialized)
            topFrame = frame.parent
            depth = depth - 1
            acceptValue(valueNode)
        }

        closeInlineTableFrame: () => {
            frame: topFrame
            (frame.kind == "inlineTable").ifFalse(() => { fail() })
            validPhase: frame.phase == "keyOrEnd"
            (frame.phase == "commaOrEnd").ifTrue(() => { validPhase = true })
            validPhase.ifFalse(() => { fail() })

            valueNode: syntaxNode("table", frame.entries)
            topFrame = frame.parent
            depth = depth - 1
            acceptValue(valueNode)
        }

        startValue: () => {
            skipSpaces()
            first: peek()
            (first < 0).ifTrue(() => { fail() })
            handled: false

            (first == 91).ifTrue(() => {
                index = index + 1
                pushArrayFrame()
                handled = true
            })
            (first == 123).ifTrue(() => {
                index = index + 1
                pushInlineTableFrame()
                handled = true
            })

            handled.ifFalse(() => {
                result: null
                (first == 34).ifTrue(() => {
                    multiline: false
                    (index + 2 < length).ifTrue(() => {
                        ((source[index + 1] == 34) &&
                            (source[index + 2] == 34)).ifTrue(() => {
                            multiline = true
                        })
                    })
                    result = syntaxNode("string", parseBasicString(multiline))
                })
                (first == 39).ifTrue(() => {
                    multiline: false
                    (index + 2 < length).ifTrue(() => {
                        ((source[index + 1] == 39) &&
                            (source[index + 2] == 39)).ifTrue(() => {
                            multiline = true
                        })
                    })
                    result = syntaxNode("string", parseLiteralString(multiline))
                })
                (result === null).ifTrue(() => {
                    result = parseBareValue()
                })
                acceptValue(result)
            })
        }

        running: true
        (() => running).whileTrue(() => {
            wasTopLevel: depth == 0

            wasTopLevel.ifTrue(() => {
                rootDone.ifTrue(() => {
                    running = false
                })
                rootDone.ifFalse(() => {
                    startValue()
                })
            })

            wasTopLevel.ifFalse(() => {
                frame: topFrame
                phase: frame.phase

                (frame.kind == "array").ifTrue(() => {
                    skipArrayTrivia()

                    (phase == "valueOrEnd").ifTrue(() => {
                        closing: peek() == 93
                        closing.ifTrue(() => {
                            index = index + 1
                            closeArrayFrame()
                        })
                        closing.ifFalse(() => {
                            frame.phase = "awaitValue"
                            startValue()
                        })
                    })

                    (phase == "value").ifTrue(() => {
                        frame.phase = "awaitValue"
                        startValue()
                    })

                    (phase == "commaOrEnd").ifTrue(() => {
                        comma: peek() == 44
                        closing: peek() == 93
                        comma.ifTrue(() => {
                            index = index + 1
                            skipArrayTrivia()
                            trailing: peek() == 93
                            trailing.ifTrue(() => {
                                index = index + 1
                                closeArrayFrame()
                            })
                            trailing.ifFalse(() => {
                                frame.phase = "value"
                            })
                        })
                        comma.ifFalse(() => {
                            closing.ifTrue(() => {
                                index = index + 1
                                closeArrayFrame()
                            })
                            closing.ifFalse(() => { fail() })
                        })
                    })
                })

                (frame.kind == "inlineTable").ifTrue(() => {
                    skipInlineTableTrivia()

                    (phase == "keyOrEnd").ifTrue(() => {
                        closing: peek() == 125
                        closing.ifTrue(() => {
                            index = index + 1
                            closeInlineTableFrame()
                        })
                        closing.ifFalse(() => {
                            frame.pendingPath = parseKeyPath()
                            skipSpaces()
                            (take() == 61).ifFalse(() => { fail() })
                            skipSpaces()
                            frame.phase = "value"
                        })
                    })

                    (phase == "value").ifTrue(() => {
                        frame.phase = "awaitValue"
                        startValue()
                    })

                    (phase == "commaOrEnd").ifTrue(() => {
                        comma: peek() == 44
                        closing: peek() == 125
                        comma.ifTrue(() => {
                            index = index + 1
                            skipInlineTableTrivia()
                            trailing: peek() == 125
                            trailing.ifTrue(() => {
                                // TOML 1.0 forbids a trailing comma in an inline table.
                                toml11.ifFalse(() => { fail() })
                                index = index + 1
                                closeInlineTableFrame()
                            })
                            trailing.ifFalse(() => {
                                frame.phase = "keyOrEnd"
                            })
                        })
                        comma.ifFalse(() => {
                            closing.ifTrue(() => {
                                index = index + 1
                                closeInlineTableFrame()
                            })
                            closing.ifFalse(() => { fail() })
                        })
                    })
                })
            })
        })

        result: rootValue
        skipSpaces()
        (peek() == 35).ifTrue(() => {
            index = index + 1
            skipComment()
        })
        (index < length).ifTrue(() => {
            isNewlineStart(peek()).ifTrue(() => { consumeNewline() })
        })
        skipSpaces()
        (index == length).ifFalse(() => { fail() })
        result

    }

    documentStatements: (text) => {
        String.recognizes(text).ifFalse(() => {
            Error().signal()
        })
        source: Encoding.UTF8.encode(text)
        index: 0
        length: source.size()

        statementChunks: Map()
        statementMaxLevel: -1
        buffer: Encoding.UTF8.encode("")
        significant: false

        carryStatementChunk: (initialChunk, initialLevel) => {
            chunk: initialChunk
            level: initialLevel
            carrying: true
            (() => carrying).whileTrue(() => {
                present: statementChunks.containsKey(level)
                present.ifTrue(() => {
                    left: statementChunks[level]
                    statementChunks.remove(level)
                    chunk = Array(...left, ...chunk)
                    level = level + 1
                })
                present.ifFalse(() => {
                    statementChunks[level] = chunk
                    (level > statementMaxLevel).ifTrue(() => {
                        statementMaxLevel = level
                    })
                    carrying = false
                })
            })
        }

        collectStatementChunks: (initialLevel, initialResult) => {
            level: initialLevel
            result: initialResult
            (() => level >= 0).whileTrue(() => {
                statementChunks.containsKey(level).ifTrue(() => {
                    result = Array(...result, ...statementChunks[level])
                })
                level = level - 1
            })
            result
        }
        squareDepth: 0
        braceDepth: 0
        stringQuote: -1
        multiline: false
        comment: false

        peek: () => {
            value: -1
            (index < length).ifTrue(() => {
                value = source[index]
            })
            value
        }

        take: () => {
            (index >= length).ifTrue(() => {
                fail()
            })
            value: source[index]
            index = index + 1
            value
        }

        append: (octet) => {
            buffer.add(octet)
            (octet == 32).ifFalse(() => {
                (octet == 9).ifFalse(() => {
                    significant = true
                })
            })
        }

        appendQuotes: (quote, count) => {
            remaining: count
            (() => remaining > 0).whileTrue(() => {
                append(quote)
                remaining = remaining - 1
            })
        }

        quoteRun: (quote) => {
            look: index
            count: 0
            scanning: true

            (() => scanning && (look < length)).whileTrue(() => {
                matches: source[look] == quote
                matches.ifTrue(() => {
                    count = count + 1
                    look = look + 1
                })
                matches.ifFalse(() => {
                    scanning = false
                })
            })

            count
        }

        finish: () => {
            significant.ifTrue(() => {
                carryStatementChunk(Array(Encoding.UTF8.decode(buffer)), 0)
            })
            buffer = Encoding.UTF8.encode("")
            significant = false
        }

        appendNewline: (include) => {
            first: take()
            (first == 10).ifTrue(() => {
                include.ifTrue(() => { append(10) })
            })
            (first == 13).ifTrue(() => {
                (peek() == 10).ifFalse(() => {
                    fail()
                })
                second: take()
                include.ifTrue(() => {
                    append(13)
                    append(second)
                })
            })
            (first == 10).ifFalse(() => {
                (first == 13).ifFalse(() => {
                    fail()
                })
            })
        }

        step: () => {
            octet: peek()

            wasComment: comment
            wasComment.ifTrue(() => {
                isNewline: octet == 10
                (octet == 13).ifTrue(() => { isNewline = true })

                isNewline.ifTrue(() => {
                    comment = false
                    nested: squareDepth > 0
                    (braceDepth > 0).ifTrue(() => { nested = true })
                    nested.ifTrue(() => {
                        appendNewline(true)
                    })
                    nested.ifFalse(() => {
                        appendNewline(false)
                        finish()
                    })
                })

                isNewline.ifFalse(() => {
                    forbiddenControl: octet < 32
                    (octet == 9).ifTrue(() => {
                        forbiddenControl = false
                    })
                    (octet == 127).ifTrue(() => {
                        forbiddenControl = true
                    })
                    forbiddenControl.ifTrue(() => {
                        fail()
                    })
                    index = index + 1
                })
            })

            wasComment.ifFalse(() => {
                wasString: stringQuote >= 0
                wasString.ifTrue(() => {
                    wasMultiline: multiline
                    wasMultiline.ifTrue(() => {
                        // Snapshot this before closing mutates stringQuote.
                        quoteOctet: octet == stringQuote
                        quoteOctet.ifTrue(() => {
                            run: quoteRun(stringQuote)
                            (run >= 3).ifTrue(() => {
                                (run > 5).ifTrue(() => {
                                    fail()
                                })
                                appendQuotes(stringQuote, run)
                                index = index + run
                                stringQuote = -1
                                multiline = false
                            })
                            (run < 3).ifTrue(() => {
                                append(take())
                            })
                        })

                        quoteOctet.ifFalse(() => {
                            escapedBasic: stringQuote == 34
                            (octet == 92).ifFalse(() => {
                                escapedBasic = false
                            })

                            escapedBasic.ifTrue(() => {
                                append(take())
                                (index >= length).ifTrue(() => {
                                    fail()
                                })
                                append(take())
                            })

                            escapedBasic.ifFalse(() => {
                                append(take())
                            })
                        })
                    })

                    wasMultiline.ifFalse(() => {
                        isNewline: octet == 10
                        (octet == 13).ifTrue(() => { isNewline = true })
                        isNewline.ifTrue(() => {
                            fail()
                        })

                        escapedBasic: stringQuote == 34
                        (octet == 92).ifFalse(() => {
                            escapedBasic = false
                        })

                        escapedBasic.ifTrue(() => {
                            append(take())
                            (index >= length).ifTrue(() => {
                                fail()
                            })
                            append(take())
                        })

                        escapedBasic.ifFalse(() => {
                            append(take())
                            (octet == stringQuote).ifTrue(() => {
                                stringQuote = -1
                            })
                        })
                    })
                })

                wasString.ifFalse(() => {
                    (octet == 35).ifTrue(() => {
                        comment = true
                        index = index + 1
                    })

                    (octet == 35).ifFalse(() => {
                        isQuote: octet == 34
                        (octet == 39).ifTrue(() => { isQuote = true })

                        isQuote.ifTrue(() => {
                            run: quoteRun(octet)
                            (run >= 3).ifTrue(() => {
                                appendQuotes(octet, 3)
                                index = index + 3
                                stringQuote = octet
                                multiline = true
                            })
                            (run < 3).ifTrue(() => {
                                append(take())
                                stringQuote = octet
                                multiline = false
                            })
                        })

                        isQuote.ifFalse(() => {
                            (octet == 91).ifTrue(() => {
                                squareDepth = squareDepth + 1
                                append(take())
                            })
                            (octet == 93).ifTrue(() => {
                                (squareDepth == 0).ifTrue(() => {
                                    fail()
                                })
                                squareDepth = squareDepth - 1
                                append(take())
                            })
                            (octet == 123).ifTrue(() => {
                                braceDepth = braceDepth + 1
                                append(take())
                            })
                            (octet == 125).ifTrue(() => {
                                (braceDepth == 0).ifTrue(() => {
                                    fail()
                                })
                                braceDepth = braceDepth - 1
                                append(take())
                            })

                            structural: octet == 91
                            (octet == 93).ifTrue(() => { structural = true })
                            (octet == 123).ifTrue(() => { structural = true })
                            (octet == 125).ifTrue(() => { structural = true })

                            structural.ifFalse(() => {
                                isNewline: octet == 10
                                (octet == 13).ifTrue(() => { isNewline = true })

                                isNewline.ifTrue(() => {
                                    nested: squareDepth > 0
                                    (braceDepth > 0).ifTrue(() => { nested = true })
                                    nested.ifTrue(() => {
                                        appendNewline(true)
                                    })
                                    nested.ifFalse(() => {
                                        appendNewline(false)
                                        finish()
                                    })
                                })

                                isNewline.ifFalse(() => {
                                    append(take())
                                })
                            })
                        })
                    })
                })
            })

        }

        visitIndex: 0
        source.each((ignoredOctet) => {
            (visitIndex == index).ifTrue(() => {
                step()
            })
            visitIndex = visitIndex + 1
        })

        (index == length).ifFalse(() => {
            fail()
        })

        (stringQuote >= 0).ifTrue(() => {
            fail()
        })
        (squareDepth != 0).ifTrue(() => {
            fail()
        })
        (braceDepth != 0).ifTrue(() => {
            fail()
        })

        finish()
        collectStatementChunks(statementMaxLevel, Array())
    }

    documentTable: (text) => {
        items: documentStatements(text)

        node: (kind, value) => {
            result: {
                kind: kind
                value: value
            }
            result
        }

        root: node("table", Map())
        states: IdentityMap()
        states[root] = "root"
        current: root

        arrayTableBuilders: IdentityMap()
        arrayTableBuilderEntries: Map()
        arrayTableBuilderCount: 0

        appendArrayTableElement: (arrayNode, element) => {
            builder: null
            arrayTableBuilders.containsKey(arrayNode).ifTrue(() => {
                builder = arrayTableBuilders[arrayNode]
            })
            arrayTableBuilders.containsKey(arrayNode).ifFalse(() => {
                builder = {
                    arrayNode: arrayNode
                    chunks: Map()
                    maxLevel: -1
                    last: null
                }
                arrayTableBuilders[arrayNode] = builder
                arrayTableBuilderEntries[arrayTableBuilderCount] = builder
                arrayTableBuilderCount = arrayTableBuilderCount + 1
            })

            chunk: Array(element)
            level: 0
            carrying: true
            (() => carrying).whileTrue(() => {
                present: builder.chunks.containsKey(level)
                present.ifTrue(() => {
                    left: builder.chunks[level]
                    builder.chunks.remove(level)
                    chunk = Array(...left, ...chunk)
                    level = level + 1
                })
                present.ifFalse(() => {
                    builder.chunks[level] = chunk
                    (level > builder.maxLevel).ifTrue(() => {
                        builder.maxLevel = level
                    })
                    carrying = false
                })
            })
            builder.last = element
        }

        materializeArrayTableBuilder: (builder) => {
            result: Array()
            level: builder.maxLevel
            (() => level >= 0).whileTrue(() => {
                builder.chunks.containsKey(level).ifTrue(() => {
                    result = Array(...result, ...builder.chunks[level])
                })
                level = level - 1
            })
            result
        }

        isSpace: (octet) => {
            result: octet == 32
            (octet == 9).ifTrue(() => {
                result = true
            })
            result
        }

        decodeRange: (source, start, end) => {
            buffer: Encoding.UTF8.encode("")
            position: start
            (() => position < end).whileTrue(() => {
                buffer.add(source[position])
                position = position + 1
            })
            Encoding.UTF8.decode(buffer)
        }

        trimBounds: (source) => {
            left: 0
            right: source.size()

            trimmingLeft: true
            (() => trimmingLeft && (left < right)).whileTrue(() => {
                whitespace: isSpace(source[left])
                whitespace.ifTrue(() => {
                    left = left + 1
                })
                whitespace.ifFalse(() => {
                    trimmingLeft = false
                })
            })

            trimmingRight: true
            (() => trimmingRight && (right > left)).whileTrue(() => {
                whitespace: isSpace(source[right - 1])
                whitespace.ifTrue(() => {
                    right = right - 1
                })
                whitespace.ifFalse(() => {
                    trimmingRight = false
                })
            })

            {
                left: left
                right: right
            }
        }

        markInlineTable: (valueNode) => {
            (valueNode.kind == "table").ifTrue(() => {
                states[valueNode] = "inline"
            })
        }

        putDotted: (tableNode, parts, ignoredPosition, valueNode) => {
            selected: tableNode
            position: 0

            (() => position < parts.count).whileTrue(() => {
                name: parts.entries[position]
                last: position == parts.count - 1
                entries: selected.value

                last.ifTrue(() => {
                    entries.containsKey(name).ifTrue(() => {
                        fail()
                    })
                    entries[name] = valueNode
                    markInlineTable(valueNode)
                    position = parts.count
                })

                last.ifFalse(() => {
                    child: null
                    entries.containsKey(name).ifTrue(() => {
                        child = entries[name]
                        (child.kind == "table").ifFalse(() => {
                            fail()
                        })
                        states.containsKey(child).ifFalse(() => {
                            fail()
                        })
                        state: states[child]
                        (state == "header").ifTrue(() => {
                            fail()
                        })
                        (state == "inline").ifTrue(() => {
                            fail()
                        })
                        (state == "implicit").ifTrue(() => {
                            states[child] = "dotted"
                        })
                    })

                    entries.containsKey(name).ifFalse(() => {
                        child = node("table", Map())
                        entries[name] = child
                        states[child] = "dotted"
                    })

                    selected = child
                    position = position + 1
                })
            })
        }

        latestArrayTable: (arrayNode) => {
            (arrayNode.kind == "array").ifFalse(() => {
                fail()
            })
            states.containsKey(arrayNode).ifFalse(() => {
                fail()
            })
            (states[arrayNode] == "array-table").ifFalse(() => {
                fail()
            })
            arrayTableBuilders.containsKey(arrayNode).ifFalse(() => {
                fail()
            })
            builder: arrayTableBuilders[arrayNode]
            selected: builder.last
            (selected === null).ifTrue(() => {
                fail()
            })
            (selected.kind == "table").ifFalse(() => {
                fail()
            })
            selected
        }

        existingParent: (child) => {
            selected: null

            (child.kind == "table").ifTrue(() => {
                states.containsKey(child).ifFalse(() => {
                    fail()
                })
                (states[child] == "inline").ifTrue(() => {
                    fail()
                })
                selected = child
            })

            (child.kind == "array").ifTrue(() => {
                selected = latestArrayTable(child)
            })

            (selected === null).ifTrue(() => {
                fail()
            })
            selected
        }

        selectHeader: (parts) => {
            selected: root
            position: 0

            (() => position < parts.count).whileTrue(() => {
                name: parts.entries[position]
                last: position == parts.count - 1
                entries: selected.value
                child: null

                entries.containsKey(name).ifTrue(() => {
                    child = entries[name]

                    last.ifTrue(() => {
                        (child.kind == "table").ifFalse(() => {
                            fail()
                        })
                        states.containsKey(child).ifFalse(() => {
                            fail()
                        })
                        state: states[child]
                        (state == "implicit").ifTrue(() => {
                            states[child] = "header"
                        })
                        (state == "implicit").ifFalse(() => {
                            fail()
                        })
                        selected = child
                    })

                    last.ifFalse(() => {
                        selected = existingParent(child)
                    })
                })

                entries.containsKey(name).ifFalse(() => {
                    child = node("table", Map())
                    entries[name] = child
                    last.ifTrue(() => {
                        states[child] = "header"
                    })
                    last.ifFalse(() => {
                        states[child] = "implicit"
                    })
                    selected = child
                })

                position = position + 1
            })

            selected
        }

        selectArrayHeader: (parts) => {
            selected: root
            position: 0
            created: null

            (() => position < parts.count).whileTrue(() => {
                name: parts.entries[position]
                last: position == parts.count - 1
                entries: selected.value
                child: null

                last.ifTrue(() => {
                    element: node("table", Map())
                    states[element] = "array-element"

                    entries.containsKey(name).ifTrue(() => {
                        child = entries[name]
                        (child.kind == "array").ifFalse(() => {
                            fail()
                        })
                        states.containsKey(child).ifFalse(() => {
                            fail()
                        })
                        (states[child] == "array-table").ifFalse(() => {
                            fail()
                        })
                    })

                    entries.containsKey(name).ifFalse(() => {
                        child = node("array", Array())
                        entries[name] = child
                        states[child] = "array-table"
                    })

                    appendArrayTableElement(child, element)
                    created = element
                })

                last.ifFalse(() => {
                    entries.containsKey(name).ifTrue(() => {
                        child = entries[name]
                        selected = existingParent(child)
                    })

                    entries.containsKey(name).ifFalse(() => {
                        child = node("table", Map())
                        entries[name] = child
                        states[child] = "implicit"
                        selected = child
                    })
                })

                position = position + 1
            })

            created
        }

        parseHeader: (statement) => {
            source: Encoding.UTF8.encode(statement)
            bounds: trimBounds(source)
            (bounds.left >= bounds.right).ifTrue(() => {
                fail()
            })
            (source[bounds.left] == 91).ifFalse(() => {
                fail()
            })
            (source[bounds.right - 1] == 93).ifFalse(() => {
                fail()
            })

            arrayHeader: false
            keyStart: bounds.left + 1
            keyEnd: bounds.right - 1

            (keyStart < keyEnd).ifTrue(() => {
                (source[keyStart] == 91).ifTrue(() => {
                    arrayHeader = true
                    (keyStart + 1 >= keyEnd).ifTrue(() => {
                        fail()
                    })
                    (source[keyEnd - 1] == 93).ifFalse(() => {
                        fail()
                    })
                    keyStart = keyStart + 1
                    keyEnd = keyEnd - 1
                })
            })

            keyText: decodeRange(source, keyStart, keyEnd)
            {
                array: arrayHeader
                path: syntaxKeyPath(keyText)
            }
        }

        parseAssignment: (statement) => {
            source: Encoding.UTF8.encode(statement)
            length: source.size()
            position: 0
            quote: -1
            separator: -1

            (() => (position < length) && (separator < 0)).whileTrue(() => {
                        octet: source[position]
                        inQuote: quote >= 0

                        inQuote.ifTrue(() => {
                            escaped: quote == 34
                            (octet == 92).ifFalse(() => {
                                escaped = false
                            })

                            escaped.ifTrue(() => {
                                position = position + 1
                                (position >= length).ifTrue(() => {
                                    fail()
                                })
                                position = position + 1
                            })

                            escaped.ifFalse(() => {
                                (octet == quote).ifTrue(() => {
                                    quote = -1
                                })
                                position = position + 1
                            })
                        })

                        inQuote.ifFalse(() => {
                            isQuote: octet == 34
                            (octet == 39).ifTrue(() => {
                                isQuote = true
                            })

                            isQuote.ifTrue(() => {
                                quote = octet
                                position = position + 1
                            })

                            isQuote.ifFalse(() => {
                                isNewline: octet == 10
                                (octet == 13).ifTrue(() => {
                                    isNewline = true
                                })
                                isNewline.ifTrue(() => {
                                    fail()
                                })

                                (octet == 61).ifTrue(() => {
                                    separator = position
                                })
                                position = position + 1
                            })
                        })

            })
            (quote >= 0).ifTrue(() => {
                fail()
            })
            (separator < 0).ifTrue(() => {
                fail()
            })

            keyText: decodeRange(source, 0, separator)
            valueText: decodeRange(source, separator + 1, length)
            {
                path: syntaxKeyPath(keyText)
                value: syntaxValue(valueText)
            }
        }

        items.each((statement) => {
            source: Encoding.UTF8.encode(statement)
            bounds: trimBounds(source)
            (bounds.left >= bounds.right).ifTrue(() => {
                fail()
            })

            header: source[bounds.left] == 91
            header.ifTrue(() => {
                parsedHeader: parseHeader(statement)
                parsedHeader.array.ifTrue(() => {
                    current = selectArrayHeader(parsedHeader.path)
                })
                parsedHeader.array.ifFalse(() => {
                    current = selectHeader(parsedHeader.path)
                })
            })

            header.ifFalse(() => {
                assignment: parseAssignment(statement)
                putDotted(current, assignment.path, 0, assignment.value)
            })
        })

        builderIndex: 0
        (() => builderIndex < arrayTableBuilderCount).whileTrue(() => {
            builder: arrayTableBuilderEntries[builderIndex]
            builder.arrayNode.value = materializeArrayTableBuilder(builder)
            builderIndex = builderIndex + 1
        })

        root
    }

    documentTable(text)
}

/// Parses one complete TOML 1.1 document into its root table node; invalid text signals
/// an Error. Equivalent to `parseDialect(text, "1.1")`.
parse: (text) => {
    parseDialect(text, "1.1")
}
