// The canonical Fraction family prototype (D197-C). Exact rational arithmetic
// and negation are ordinary source closures over Integer arithmetic. They read
// canonical components and request the canonical result only through the
// private bootstrap kernel below, which the runtime fills with exactly
// numerator, denominator, normalize and toFloat; the kernel never owns
// arithmetic. Only the exact recognizer is native, because it must not
// dispatch on the candidate. A Float operand is combined after rounding the
// whole exact quotient once to binary64 (D196-B1, D197).
Fraction: Number {
    negated: () => {
        Fraction.recognizes(this).ifFalse(() => {
            Error().signal()
        })
        _coreFractionKernel.normalize(
            0 - _coreFractionKernel.numerator(this),
            _coreFractionKernel.denominator(this))
    }

    // Installed by the runtime as `+`; a slot target cannot spell an operator.
    _coreFractionPlus: (other) => {
        Fraction.recognizes(this).ifFalse(() => {
            Error().signal()
        })
        Float.recognizes(other).ifTrueIfFalse(
            () => { _coreFractionKernel.toFloat(this) + other },
            () => {
                Complex.recognizes(other).ifTrueIfFalse(
                    () => { _coreComplexKernel.plus(this, other) },
                    () => {
                        a: _coreFractionKernel.numerator(this)
                        b: _coreFractionKernel.denominator(this)
                        c: _coreFractionKernel.numerator(other)
                        d: _coreFractionKernel.denominator(other)
                        _coreFractionKernel.normalize((a * d) + (c * b), b * d)
                    })
            })
    }

    // Installed by the runtime as `-`.
    _coreFractionMinus: (other) => {
        Fraction.recognizes(this).ifFalse(() => {
            Error().signal()
        })
        Float.recognizes(other).ifTrueIfFalse(
            () => { _coreFractionKernel.toFloat(this) - other },
            () => {
                Complex.recognizes(other).ifTrueIfFalse(
                    () => { _coreComplexKernel.minus(this, other) },
                    () => {
                        a: _coreFractionKernel.numerator(this)
                        b: _coreFractionKernel.denominator(this)
                        c: _coreFractionKernel.numerator(other)
                        d: _coreFractionKernel.denominator(other)
                        _coreFractionKernel.normalize((a * d) - (c * b), b * d)
                    })
            })
    }

    // Installed by the runtime as `*`.
    _coreFractionTimes: (other) => {
        Fraction.recognizes(this).ifFalse(() => {
            Error().signal()
        })
        Float.recognizes(other).ifTrueIfFalse(
            () => { _coreFractionKernel.toFloat(this) * other },
            () => {
                Complex.recognizes(other).ifTrueIfFalse(
                    () => { _coreComplexKernel.times(this, other) },
                    () => {
                        a: _coreFractionKernel.numerator(this)
                        b: _coreFractionKernel.denominator(this)
                        c: _coreFractionKernel.numerator(other)
                        d: _coreFractionKernel.denominator(other)
                        _coreFractionKernel.normalize(a * c, b * d)
                    })
            })
    }

    // Installed by the runtime as `/`. An exact zero divisor signals the
    // standard Error from normalize.
    _coreFractionDivide: (other) => {
        Fraction.recognizes(this).ifFalse(() => {
            Error().signal()
        })
        Float.recognizes(other).ifTrueIfFalse(
            () => { _coreFractionKernel.toFloat(this) / other },
            () => {
                Complex.recognizes(other).ifTrueIfFalse(
                    () => { _coreComplexKernel.divide(this, other) },
                    () => {
                        a: _coreFractionKernel.numerator(this)
                        b: _coreFractionKernel.denominator(this)
                        c: _coreFractionKernel.numerator(other)
                        d: _coreFractionKernel.denominator(other)
                        _coreFractionKernel.normalize(a * d, b * c)
                    })
            })
    }
}

_coreFractionKernel: {}
